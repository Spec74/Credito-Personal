<script type="text/javascript">
    $(document).ready(function () {
        $("#txtFechaIni,#txtFechaIniCajaChica,#txtFechaIniCajaAnulado,#txtFechaIniCondonacion").val("@ITB.VENDIX.BL.VendixGlobal.GetFecha().AddDays(- ITB.VENDIX.BL.VendixGlobal.GetFecha().Day + 1).ToString("dd/MM/yyyy")");
        $("#txtFechaFin,#txtFechaFinCajaChica,#txtFechaFinCajaAnulado,#txtFechaFinCondonacion").val("@ITB.VENDIX.BL.VendixGlobal.GetFecha().AddDays(-ITB.VENDIX.BL.VendixGlobal.GetFecha().Day + 1).AddMonths(1).AddDays(-1).ToString("dd/MM/yyyy")");
        $("#txtHastaFecha,#txtFechaAprobacion").val("@ITB.VENDIX.BL.VendixGlobal.GetFecha().ToString("dd/MM/yyyy")");

        $("#cboAnio,#cboAnioIni").val(@ITB.VENDIX.BL.VendixGlobal.GetFecha().AddMonths(-1).Year).trigger("liszt:updated");
        $("#cboMes,#cboMesIni").val(@ITB.VENDIX.BL.VendixGlobal.GetFecha().AddMonths(-1).Month).trigger("liszt:updated");
        $("#cboAnioFin").val(@ITB.VENDIX.BL.VendixGlobal.GetFecha().Year).trigger("liszt:updated");
        $("#cboMesFin").val(@ITB.VENDIX.BL.VendixGlobal.GetFecha().Month).trigger("liszt:updated");

        $('#btnCentralRiesgo').click(function () {
            var oficina = $('#cboOficina2').val();
            if (oficina.length == 0) oficina = null;

            window.location.href = '@Url.Action("ReporteCentrarRiegoTXT", "Reporte")'
                + '?pOficinaid=' + oficina
                + '&pAnio=' + $("#cboAnio").val()
                + '&pMes=' + $("#cboMes").val();
            return false;
        });

        $("#btnRptCredito").click(function () {
            event.preventDefault();
            var oficina = $('#cboOficina').val();
            if (oficina.length == 0) oficina = null;
            var usuario = $('#cboGestor2').val();
            if (usuario.length == 0) usuario = null;

            var ruta = '@Url.Action("ReporteCredito", "Reporte")'
                + '?pOficinaid=' + oficina
                + '&pGestorid=' + usuario
                + '&pEstadoCredito=' + $("#cboEstadoCredito").val()
                + '&pFechaIni=' + $('#txtFechaIni').val()
                + '&pFechaFin=' + $('#txtFechaFin').val();

            window.open(ruta);
            return false;
        });

        $("#btnReporteSaldoCartera").click(function () {
            event.preventDefault();
            var oficina = $('#cboOficina6').val();
            if (oficina.length == 0) oficina = null;
            //var usuario = $('#cboGestor2').val();
            //if (usuario.length == 0) usuario = null;

            var ruta = '@Url.Action("ReporteSaldoCarteraCajaDiario", "Reporte")'
                + '?pOficinaid=' + oficina
                + '&anioIni=' + $('#cboAnioIni').val()
                + '&mesIni=' + $('#cboMesIni').val()
                + '&anioFin=' + $('#cboAnioFin').val()
                + '&mesFin=' + $('#cboMesFin').val();

            //alert(ruta );
            window.open(ruta);
            return false;
        });

        $("#btnRptRentabilidadPdf").click(function () {
            event.preventDefault();
            window.open(obtenerRutaRentabilidad('PDF'));
            return false;
        });
        $("#btnRptRentabilidadXls").click(function () {
            event.preventDefault();
            window.open(obtenerRutaRentabilidad('Excel'));
            return false;
        });
        function obtenerRutaRentabilidad(tipo) {
            var oficina = $('#cboOficina').val();
            if (oficina.length == 0) oficina = null;

            var ruta = '@Url.Action("ReporteCreditoRentabilidad", "Reporte")'
                + '?pFechaIni=' + $('#txtFechaIni').val()
                + '&pFechaFin=' + $('#txtFechaFin').val()
                + '&pEstadoCredito=' + $("#cboEstadoCredito").val()
                + '&indTodos=' + $("#chkTodo").prop('checked')
                + '&pOficinaid=' + oficina
                + '&pTipo=' + tipo;
            return ruta;
        };

        $("#btnRptComprobantesPdf").click(function () {
            event.preventDefault();
            window.open(obtenerRutaComprobantes('PDF'));
            return false;
        });
        $("#btnRptComprobantesXls").click(function () {
            event.preventDefault();
            window.open(obtenerRutaComprobantes('Excel'));
            return false;
        });
        function obtenerRutaComprobantes(tipo) {

            var ruta = '@Url.Action("ReporteComprobantesCajaChica", "Reporte")'
                + '?pFechaIni=' + $('#txtFechaIniCajaChica').val()
                + '&pFechaFin=' + $('#txtFechaFinCajaChica').val()
                + '&pTipo=' + tipo;
            return ruta;
        };
        $("#btnRptComprobantesAnuladosPdf").click(function () {
            event.preventDefault();
            window.open(obtenerRutaComprobantesAnulados('PDF'));
            return false;
        });
        $("#btnRptComprobantesAnuladosXls").click(function () {
            event.preventDefault();
            window.open(obtenerRutaComprobantesAnulados('Excel'));
            return false;
        });
        function obtenerRutaComprobantesAnulados(tipo) {

            var ruta = '@Url.Action("ReporteComprobantesCajaAnulados", "Reporte")'
                + '?pFechaIni=' + $('#txtFechaIniCajaAnulado').val()
                + '&pFechaFin=' + $('#txtFechaFinCajaAnulado').val()
                + '&pTipo=' + tipo;
            return ruta;
        };

        $("#btnRptCreditoAprobado").click(function () {
            event.preventDefault();
            var oficina = $('#cboOficina4').val();
            if (oficina.length == 0) oficina = null;
            var usuario = $('#cboGestor').val();
            if (usuario.length == 0) usuario = null;

            var ruta = '@Url.Action("ReporteCreditoAprobado", "Reporte")'
                + '?pFecha=' + $('#txtFechaAprobacion').val()
                + '&pUsuarioid=' + usuario
                + '&pOficinaid=' + oficina;
            //alert(ruta );
            window.open(ruta);
            return false;
        });

        $("#btnRptCreditoAprobadoPdf").click(function () {
            event.preventDefault();
            window.open(obtenerRutaCreditoAprobado('PDF'));
            return false;
        });

        $("#btnRptCreditoAprobadoExcel").click(function () {
            event.preventDefault();
            window.open(obtenerRutaCreditoAprobado('Excel'));
            return false;
        });

        function obtenerRutaCreditoAprobado(tipo) {
