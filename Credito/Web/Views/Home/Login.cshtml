<body class="login">
    <!-- Some dialogs etc. -->
    <!-- The loading box -->
    <div id="loading-overlay"></div>
    <div id="loading"> <span>Loading...</span> </div>
    <!-- End of loading box -->
    <!--------------------------------->
    <!-- Now, the page itself begins -->
    <!--------------------------------->
    <!-- The header containing the logo -->
    <div style="height: 200px">

    </div>
    <!-- End of header -->
    <!-- The container of the sidebar and content box -->
    <section id="login" class="container_12 clearfix">
        <form action="@Url.Action("Autenticar", "Home", null, "http")" method="post" class="box validate">
            <div class="header  center-elements" style="background: #fff;">
                @*<h2><span class="icon icon-lock"></span>CREDICONFIANZA</h2>*@
                <img src="~/img/credix.png" width="350" />
            </div>
            <div class="content">
                <!-- Login messages -->
                @*<div class="login-messages">
                        @if (string.IsNullOrEmpty(ViewBag.mensaje) )
                        {
                           <div class="message failure">Credentiales Invalidos.</div>
                        }
                        else
                        {
                             <div class="message failure" style="display: block;">@ViewBag.mensaje</div>
                        }
                    </div>*@
                <!-- The form -->
                <div class="form-box">
                    <input name="tk" id="tk" type="hidden">
                    <div class="row">
                        <label for="login_name"> <strong>Usuario</strong></label>
                        <div> <input tabindex="1" class="required noerror" name="login_name" id="login_name" type="text" autofocus> </div>
                    </div>
                    <div class="row">
                        <label for="login_pw"> <strong>Clave</strong></label>
                        <div> <input tabindex="2" class="required noerror" name="login_pw" id="login_pw" type="password"> </div>
                    </div>
                    <div class="row">
                        <label for="login_oficina"> <strong>Oficina</strong></label>
                        <div>
                            @* <select id="cboOficina" name="cboOficina"></select>*@
                            @Html.DropDownList("cboOficina")
                        </div>
                    </div>
                </div>
                <!-- End of .form-box -->
            </div>
            <!-- End of .content -->
            <div class="actions">
                <div class="left">

                    <div class="rememberme">
                        <input type="button" id="btnAcceso" onclick="AsignarAcceso()" class="button grey block" value="Acceso"/>
                        <input tabindex="4" name="login_remember" id="login_remember" checked="checked" type="checkbox">
                        <label for="login_remember">Recordar?</label>
                    </div>
                </div>
                <div class="right">
                    @*<input data-ajax="true" value="Ingresar" type="submit">*@
                    <button type="submit" data-ajax="true">Iniciar</button>
                </div>
            </div>
            <!-- End of .actions -->
        </form>

        <!-- End of form -->
    </section>
    <!-- Spawn $$.loaded -->

    <div style="display: none;" id="dlgConfirmarClave" title="Autorización">
        <div class="actions">
            <form class="full validate">
                <div class="row">
                    <div>
                        <input type="password" id="txtConfirmarClave" placeholder="Clave" />
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
            <div class="right">
                <input id="btnConfirmarClave" type="button" value="Confirmar" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        async function getIpClient(){
            try {
                const response =await axios.get('https://api.ipify.org?format=json');
                //console.log(response.data.ip);
                document.getElementById("tk").value = response.data.ip;
            } catch (error) {
                console.error(error);
            }
        };
        getIpClient();

        function AsignarAcceso(){
            event.preventDefault();

            var $el = $("#dlgConfirmarClave");
            $el.find('form')[0].reset();
            $('#dlgConfirmarClave').dialog('open');
        }
        $(function () {
           
            $("#dlgConfirmarClave").dialog({
                autoOpen: false,
                modal: true,
                width: 400,
                open: function () { $(this).parent().css('overflow', 'visible'); $$.utils.forms.resize(); }
            }).find('#btnConfirmarClave').click(function () {
                $.ajax({
                    url: "@Url.Action("ConfirmarClave", "Home")",
                    data: {
                        clave: $('#txtConfirmarClave').val()
                    },
                    success: function (ret) {
                        if (ret.Error) {
                            Vendix.Mensaje(ret.Mensaje);
                        }
                        else {
                            $("#dlgConfirmarClave").dialog('close');
                            Vendix.Dialogo("CONFIRMAR para realizar esta operación.", "SiNo", function () {
                                $.ajax({
                                    url: "@Url.Action("CrearAcceso", "Home")",
                                    data: {
                                        pDireccion: $("#tk").val()                                        
                                    },
                                    success: function (retorno) {
                                        console.log(retorno);
                                        if (retorno.Error == false) {
                                            Vendix.Notificar();                                           
                                        } else {
                                            Vendix.Dialogo(retorno);
                                        }
                                    }
                                });
                            });
                        }
                    }
                });
            }).end().find('button.cancel').click(function () {
                var $el = $(this).parents('.ui-dialog-content');
                $el.find('form')[0].reset();
                $el.dialog('close');
            });
        });
    </script>

</body>
