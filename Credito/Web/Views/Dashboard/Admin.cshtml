<script type="text/javascript">

    var datosAdminAnalistas = [];

    $(function () {
        inicializarDashboardAdmin();
    });

    function inicializarDashboardAdmin() {
        vincularEventosAdmin();

        /*
            PRIORIZAMOS EL RESUMEN GERENCIAL.

            Antes se lanzaban los 5 AJAX al mismo tiempo y el SP del
            resumen competía por CPU/IO/conexiones con flujo, históricos
            y analistas justo al iniciar sesión.

            Ahora cargamos primero las cards superiores y, cuando esa
            petición termina, iniciamos las secciones secundarias.
        */
        cargarDashboardAdmin();
    }

    function cargarSeccionesSecundariasAdmin() {
        cargarAdminFlujoCaja();
        cargarAdminHistorico();
        cargarAdminHistoricoMensual();
        cargarAdminAnalistas();
    }

    function vincularEventosAdmin() {
        $("#txtBuscarAnalista")
            .unbind("keyup.adminAnalistas")
            .bind("keyup.adminAnalistas", filtrarAnalistas);

        $(window)
            .unbind("scroll.adminTooltip resize.adminTooltip")
            .bind("scroll.adminTooltip resize.adminTooltip", ocultarTooltipGrafico);
    }

    /* =========================================================
       AJAX
       ========================================================= */

    function consultarJson(url, mensajeError, alCargar, alError) {
        $.ajax({
            url: url,
            type: "GET",
            dataType: "json",

            success: function (respuesta) {
                if (!respuesta || respuesta.Error) {
                    alError(
                        respuesta && respuesta.Mensaje
                            ? respuesta.Mensaje
                            : mensajeError
                    );
                    return;
                }

                alCargar(respuesta.Data);
            },

            error: function () {
                alError(mensajeError);
            }
        });
    }

    function cargarDashboardAdmin() {
        consultarJson(
            '@Url.Action("ObtenerAdminResumen", "Dashboard")',
            "No se pudo cargar el dashboard gerencial.",
            function (datos) {
                pintarDashboardAdmin(datos);

                /*
                    Las cards ya están pintadas. Recién ahora pedimos
                    el resto del dashboard para no competir con la carga
                    inicial que ve el ADMIN al ingresar.
                */
                cargarSeccionesSecundariasAdmin();
            },
            function (mensaje) {
                alert(mensaje);

                /*
                    Si el resumen falla, no bloqueamos el resto de la
                    pantalla: las demás secciones aún pueden cargar.
                */
                cargarSeccionesSecundariasAdmin();
            }
        );
    }

    function cargarAdminFlujoCaja() {
        consultarJson(
            '@Url.Action("ObtenerAdminFlujoCaja", "Dashboard")',
            "No se pudo cargar el flujo de caja.",
            function (datos) {
                pintarAdminFlujoCaja(datos || []);
            },
            mostrarErrorFlujoCaja
        );
    }

    function cargarAdminHistorico() {
        consultarJson(
            '@Url.Action("ObtenerAdminHistorico", "Dashboard")',
            "No se pudo cargar la evolución histórica.",
            function (datos) {
                pintarAdminHistorico(datos || []);
            },
            mostrarErrorHistorico
        );
    }

    function cargarAdminHistoricoMensual() {
        consultarJson(
            '@Url.Action("ObtenerAdminHistoricoMensual", "Dashboard")',
            "No se pudo cargar la evolución mensual.",
            function (datos) {
                pintarAdminHistoricoMensual(datos || []);
            },
            mostrarErrorHistoricoMensual
        );
    }

    function cargarAdminAnalistas() {
        consultarJson(
            '@Url.Action("ObtenerAdminAnalistas", "Dashboard")',
            "No se pudo cargar el rendimiento de los analistas.",
            function (datos) {
                datosAdminAnalistas = datos || [];
                pintarTablaAnalistas(datosAdminAnalistas);
            },
            mostrarErrorAnalistas
        );
    }

    /* =========================================================
       RESUMEN GERENCIAL
       ========================================================= */

    function pintarDashboardAdmin(d) {
        if (!d) {
            return;
        }

        $("#lblFechaAdmin").text(formatearFechaMvc(d.FechaConsulta));

        pintarKpiDiarioTresDias(
            "#lblCobradoHoy",
            "#varCobradoHoy",
            "#detalleCobradoHoy",
            d.CobradoHoy,
            d.CobradoAyer,
            d.CobradoAnteayer,
            formatoMoneda
        );

        pintarKpiDiarioTresDias(
            "#lblDesembolsoHoy",
            "#varDesembolsoHoy",
            "#detalleDesembolsoHoy",
            d.DesembolsoHoy,
            d.DesembolsoAyer,
            d.DesembolsoAnteayer,
            formatoMoneda
        );

        pintarKpiDiarioTresDias(
            "#lblCreditosHoy",
            "#varCreditosHoy",
            "#detalleCreditosHoy",
            d.CreditosHoy,
            d.CreditosAyer,
            d.CreditosAnteayer,
            formatoNumero
        );

        pintarKpiDiarioTresDias(
            "#lblFlujoHoy",
            "#varFlujoHoy",
            "#detalleFlujoHoy",
            d.FlujoNetoHoy,
            d.FlujoNetoAyer,
            d.FlujoNetoAnteayer,
            formatoMoneda
        );

        pintarKpi(
            "#lblCobradoMes",
            "#varCobradoMes",
            "#detalleCobradoMes",
            d.CobradoMesActual,
            d.CobradoMesAnteriorComparable,
            "Período anterior: ",
            formatoMoneda,
            false
        );

        pintarKpi(
            "#lblDesembolsoMes",
            "#varDesembolsoMes",
            "#detalleDesembolsoMes",
            d.DesembolsoMesActual,
            d.DesembolsoMesAnteriorComparable,
            "Período anterior: ",
            formatoMoneda,
            false
        );

        pintarKpi(
            "#lblCreditosMes",
            "#varCreditosMes",
            "#detalleCreditosMes",
            d.CreditosMesActual,
            d.CreditosMesAnteriorComparable,
            "Período anterior: ",
            formatoNumero,
            false
        );

        pintarKpi(
            "#lblFlujoMes",
            "#varFlujoMes",
            "#detalleFlujoMes",
            d.FlujoNetoMesActual,
            d.FlujoNetoMesAnteriorComparable,
            "Período anterior: ",
            formatoMoneda,
            false
        );

        $("#lblSaldoCartera").text(formatoMoneda(d.SaldoCartera));
        $("#lblSaldoCreditos").text(formatoMoneda(d.SaldoCreditos));
        $("#lblSaldoMoraCartera").text(formatoMoneda(d.SaldoMoraCartera));
        $("#lblSaldoVencido").text(formatoMoneda(d.SaldoVencido));
        $("#lblSaldoMorosidad").text(formatoMoneda(d.SaldoMorosidad));

        $("#lblTotalClientes").text(formatoNumero(d.TotalClientes));
        $("#lblClientesMora").text(formatoNumero(d.ClientesMora));
        $("#lblPorVencer").text(formatoNumero(d.CreditosPorVencerSemana));
        $("#lblTotalAnalistas").text(formatoNumero(d.TotalAnalistas));
    }

    /*
        KPI DIARIO DE 3 DÍAS

        - El valor principal sigue siendo HOY.
        - El detalle muestra AYER y ANTEAYER.
        - La variación se calcula entre AYER y ANTEAYER porque
          ambos representan días ya cerrados.
    */
    function pintarKpiDiarioTresDias(
        selectorValor,
        selectorVariacion,
        selectorDetalle,
        hoy,
        ayer,
        anteayer,
        formateador) {

        hoy = numeroSeguro(hoy);
        ayer = numeroSeguro(ayer);
        anteayer = numeroSeguro(anteayer);

        $(selectorValor).text(
            formateador(hoy)
        );

        $(selectorDetalle).html(
            "Ayer: " +
            escaparHtml(formateador(ayer)) +
            "<br />" +
            "Anteayer: " +
            escaparHtml(formateador(anteayer))
        );

        pintarVariacionDiasCerrados(
            selectorVariacion,
            ayer,
            anteayer
        );
    }


    /*
        Tendencia del bloque diario:
        AYER vs. ANTEAYER.
    */
    function pintarVariacionDiasCerrados(
        selectorVariacion,
        ayer,
        anteayer) {

        ayer = numeroSeguro(ayer);
        anteayer = numeroSeguro(anteayer);

        var $variacion = $(selectorVariacion);

        $variacion.removeClass(
            "admin-kpi-positive admin-kpi-negative admin-kpi-neutral"
        );

        if (anteayer === 0) {
            if (ayer === 0) {
                $variacion
                    .addClass("admin-kpi-neutral")
                    .text("● Sin variación · Ayer vs. anteayer");
            }
            else {
                $variacion
                    .addClass(
                        ayer > 0
                            ? "admin-kpi-positive"
                            : "admin-kpi-negative"
                    )
                    .text("● Sin base comparable · Ayer vs. anteayer");
            }

            return;
        }

        var porcentaje =
            ((ayer - anteayer) / Math.abs(anteayer)) * 100;

        if (porcentaje > 0) {
            $variacion
                .addClass("admin-kpi-positive")
                .text(
                    "▲ +" +
                    porcentaje.toFixed(1) +
                    "% · Ayer vs. anteayer"
                );
        }
        else if (porcentaje < 0) {
            $variacion
                .addClass("admin-kpi-negative")
                .text(
                    "▼ -" +
                    Math.abs(porcentaje).toFixed(1) +
                    "% · Ayer vs. anteayer"
                );
        }
        else {
            $variacion
                .addClass("admin-kpi-neutral")
                .text("● 0.0% · Ayer vs. anteayer");
        }
    }


    function pintarKpi(
        selectorValor,
        selectorVariacion,
        selectorDetalle,
        actual,
        anterior,
        textoDetalle,
        formateador,
        detalleConSigno) {

        $(selectorValor).text(formateador(actual));

        pintarVariacion(
            selectorVariacion,
            selectorDetalle,
            actual,
            anterior,
            textoDetalle,
            formateador,
            detalleConSigno
        );
    }

    function pintarVariacion(
        selectorVariacion,
        selectorDetalle,
        actual,
        anterior,
        textoDetalle,
        formateador,
        detalleConSigno) {

        actual = numeroSeguro(actual);
        anterior = numeroSeguro(anterior);

        var $variacion = $(selectorVariacion);
        var $detalle = $(selectorDetalle);

        $variacion.removeClass(
            "admin-kpi-positive admin-kpi-negative admin-kpi-neutral"
        );

        var textoAnterior = detalleConSigno
            ? formatoMonedaConSigno(anterior)
            : formateador(anterior);

        $detalle.text(textoDetalle + textoAnterior);

        if (anterior === 0) {
            if (actual === 0) {
                $variacion
                    .addClass("admin-kpi-neutral")
                    .text("● Sin variación");
            }
            else {
                $variacion
                    .addClass(
                        actual > 0
                            ? "admin-kpi-positive"
                            : "admin-kpi-negative"
                    )
                    .text("● Sin base comparable");
            }

            return;
        }

        var porcentaje =
            ((actual - anterior) / Math.abs(anterior)) * 100;

        if (porcentaje > 0) {
            $variacion
                .addClass("admin-kpi-positive")
                .text("▲ +" + porcentaje.toFixed(1) + "%");
        }
        else if (porcentaje < 0) {
            $variacion
                .addClass("admin-kpi-negative")
                .text("▼ -" + Math.abs(porcentaje).toFixed(1) + "%");
        }
        else {
            $variacion
                .addClass("admin-kpi-neutral")
                .text("● 0.0%");
        }
    }

    /* =========================================================
       FLUJO DE CAJA
       ========================================================= */

    function pintarAdminFlujoCaja(datos) {
        var entradas = [];
        var salidas = [];

        var totalEntradas = 0;
        var totalSalidas = 0;
        var totalEntradasAnterior = 0;
        var totalSalidasAnterior = 0;

        var transferenciaEntrada = 0;
        var transferenciaSalida = 0;
        var transferenciaEntradaAnterior = 0;
        var transferenciaSalidaAnterior = 0;

        $.each(datos, function (index, item) {
            var importeActual = numeroSeguro(item.ImporteMesActual);
            var importeAnterior = numeroSeguro(item.ImporteMesAnteriorComparable);

            if (item.IndEntrada) {
                entradas.push(item);
                totalEntradas += importeActual;
                totalEntradasAnterior += importeAnterior;
            }
            else {
                salidas.push(item);
                totalSalidas += importeActual;
                totalSalidasAnterior += importeAnterior;
            }

            if (item.EsTransferencia) {
                if (item.IndEntrada) {
                    transferenciaEntrada += importeActual;
                    transferenciaEntradaAnterior += importeAnterior;
                }
                else {
                    transferenciaSalida += importeActual;
                    transferenciaSalidaAnterior += importeAnterior;
                }
            }
        });

        $("#lblFlujoEntradas").text(formatoMoneda(totalEntradas));
        $("#lblFlujoSalidas").text(formatoMoneda(totalSalidas));

        pintarListaFlujo("#listaFlujoEntradas", entradas);
        pintarListaFlujo("#listaFlujoSalidas", salidas);

        var flujoActual = totalEntradas - totalSalidas;
        var flujoAnterior = totalEntradasAnterior - totalSalidasAnterior;

        pintarValorFlujo(
            "#lblFlujoCajaNeto",
            flujoActual
        );

        pintarVariacion(
            "#varFlujoCajaNeto",
            "#detalleFlujoCajaNeto",
            flujoActual,
            flujoAnterior,
            "Período anterior: ",
            formatoMoneda,
            true
        );

        var flujoSinTransferencias =
            (totalEntradas - transferenciaEntrada) -
            (totalSalidas - transferenciaSalida);

        var flujoSinTransferenciasAnterior =
            (totalEntradasAnterior - transferenciaEntradaAnterior) -
            (totalSalidasAnterior - transferenciaSalidaAnterior);

        pintarValorFlujo(
            "#lblFlujoSinTransferencias",
            flujoSinTransferencias
        );

        pintarVariacion(
            "#varFlujoSinTransferencias",
            "#detalleFlujoSinTransferencias",
            flujoSinTransferencias,
            flujoSinTransferenciasAnterior,
            "Período anterior: ",
            formatoMoneda,
            true
        );

        $("#lblTransferenciasEntrada").text(
            formatoMoneda(transferenciaEntrada)
        );

        $("#lblTransferenciasSalida").text(
            formatoMoneda(transferenciaSalida)
        );
    }

    function pintarValorFlujo(selector, valor) {
        valor = numeroSeguro(valor);

        $(selector)
            .text(formatoMonedaConSigno(valor))
            .removeClass(
                "admin-flujo-value-positive admin-flujo-value-negative"
            )
            .addClass(
                valor >= 0
                    ? "admin-flujo-value-positive"
                    : "admin-flujo-value-negative"
            );
    }

    function pintarListaFlujo(selector, datos) {
        var $contenedor = $(selector);
        $contenedor.empty();

        if (!datos || datos.length === 0) {
            $contenedor.html(
                '<div class="admin-flujo-empty">' +
