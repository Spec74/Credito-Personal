                    escaparHtml(mensaje) +
                "</td>" +
            "</tr>"
        );
    }

    /* =========================================================
       FORMATO Y UTILIDADES
       ========================================================= */

    function numeroSeguro(valor) {
        var numero = Number(valor);

        return isNaN(numero)
            ? 0
            : numero;
    }

    function formatoMoneda(valor) {
        valor = numeroSeguro(valor);

        return "S/ " +
            valor.toLocaleString(
                "es-PE",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
    }

    function formatoMonedaConSigno(valor) {
        valor = numeroSeguro(valor);

        if (valor > 0) {
            return "+ " + formatoMoneda(valor);
        }

        if (valor < 0) {
            return "- " + formatoMoneda(Math.abs(valor));
        }

        return formatoMoneda(0);
    }

    function formatoNumero(valor) {
        return numeroSeguro(valor)
            .toLocaleString("es-PE");
    }

    function escaparHtml(texto) {
        return $("<div>")
            .text(
                texto === null ||
                typeof texto === "undefined"
                    ? ""
                    : String(texto)
            )
            .html();
    }

    function obtenerFechaMvc(valor) {
        if (!valor) {
            return null;
        }

        var fecha;

        if (typeof valor === "string" &&
            valor.indexOf("/Date(") === 0) {

            var milisegundos = parseInt(
                valor.replace(
                    /\/Date\((-?\d+)\)\//,
                    "$1"
                ),
                10
            );

            fecha = new Date(milisegundos);
        }
        else {
            fecha = new Date(valor);
        }

        return isNaN(fecha.getTime())
            ? null
            : fecha;
    }

    function dosDigitos(valor) {
        return valor < 10
            ? "0" + valor
            : String(valor);
    }

    function formatearFechaMvc(valor) {
        var fecha = obtenerFechaMvc(valor);

        if (!fecha) {
            return "--";
        }

        return dosDigitos(fecha.getDate()) +
            "/" +
            dosDigitos(fecha.getMonth() + 1) +
            "/" +
            fecha.getFullYear();
    }

    function formatearFechaCorta(valor) {
        var fecha = obtenerFechaMvc(valor);

        if (!fecha) {
            return "--";
        }

        var meses = [
            "Ene", "Feb", "Mar",
            "Abr", "May", "Jun",
            "Jul", "Ago", "Sep",
            "Oct", "Nov", "Dic"
        ];

        return fecha.getDate() +
            " " +
            meses[fecha.getMonth()];
    }

    function formatearFechaCompleta(valor) {
        return formatearFechaMvc(valor);
    }

    function formatearMesCorto(valor) {
        var fecha = obtenerFechaMvc(valor);

        if (!fecha) {
            return "--";
        }

        var meses = [
            "Ene", "Feb", "Mar",
            "Abr", "May", "Jun",
            "Jul", "Ago", "Sep",
            "Oct", "Nov", "Dic"
        ];

        return meses[fecha.getMonth()] +
            " " +
            String(fecha.getFullYear()).substr(2, 2);
    }

    function formatearMesCompleto(valor) {
        var fecha = obtenerFechaMvc(valor);

        if (!fecha) {
            return "--";
        }

        var meses = [
            "Enero",
            "Febrero",
            "Marzo",
            "Abril",
            "Mayo",
            "Junio",
            "Julio",
            "Agosto",
            "Septiembre",
            "Octubre",
            "Noviembre",
            "Diciembre"
        ];

        return meses[fecha.getMonth()] +
            " " +
            fecha.getFullYear();
    }

</script>
