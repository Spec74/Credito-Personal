    function filtrarAnalistas() {
        var texto =
            $.trim($("#txtBuscarAnalista").val())
                .toLowerCase();

        if (!texto) {
            pintarTablaAnalistas(datosAdminAnalistas);
            return;
        }

        var filtrados = $.grep(
            datosAdminAnalistas,
            function (item) {
                var nombre =
                    (item.NombreCompleto || "")
                        .toLowerCase();

                var usuario =
                    (item.NombreUsuario || "")
                        .toLowerCase();

                return nombre.indexOf(texto) >= 0 ||
                    usuario.indexOf(texto) >= 0;
            }
        );

        pintarTablaAnalistas(filtrados);
    }

    function obtenerHtmlVariacion(valor) {
        if (valor === null ||
            typeof valor === "undefined") {

            return '<span class="admin-trend admin-trend-neutral">--</span>';
        }

        valor = numeroSeguro(valor);

        if (valor > 0) {
            return '<span class="admin-trend admin-trend-positive">' +
                "▲ +" + valor.toFixed(1) + "%" +
                "</span>";
        }

        if (valor < 0) {
            return '<span class="admin-trend admin-trend-negative">' +
                "▼ -" + Math.abs(valor).toFixed(1) + "%" +
                "</span>";
        }

        return '<span class="admin-trend admin-trend-neutral">' +
            "● 0.0%" +
            "</span>";
    }

    function obtenerHtmlMora(porcentaje, monto) {
        porcentaje = numeroSeguro(porcentaje);
        monto = numeroSeguro(monto);

        var clase = "admin-mora-low";

        if (porcentaje >= 30) {
            clase = "admin-mora-high";
        }
        else if (porcentaje >= 15) {
            clase = "admin-mora-medium";
        }

        return '' +
            '<div class="admin-mora-cell">' +
                '<strong class="admin-mora-amount">' +
                    formatoMoneda(monto) +
                '</strong>' +
                '<span class="admin-mora ' + clase + '">' +
                    porcentaje.toFixed(1) + "%" +
                '</span>' +
            '</div>';
    }

