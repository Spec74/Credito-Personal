            var claseTransferencia =
                item.EsTransferencia
                    ? " admin-flujo-item-transfer"
                    : "";

            $contenedor.append(
                '<div class="admin-flujo-item' + claseTransferencia + '">' +
                    '<div class="admin-flujo-item-info">' +
                        '<span class="admin-flujo-item-name">' +
                            escaparHtml(concepto) +
                        "</span>" +
                        "<small>" +
                            formatoNumero(item.CantidadMesActual) +
                            " movimientos" +
                        "</small>" +
                    "</div>" +
                    "<strong>" +
                        formatoMoneda(item.ImporteMesActual) +
                    "</strong>" +
                "</div>"
            );
        });
    }

    function mostrarErrorFlujoCaja(mensaje) {
        var html =
            '<div class="admin-flujo-error">' +
                escaparHtml(mensaje) +
            "</div>";

        $("#listaFlujoEntradas").html(html);
        $("#listaFlujoSalidas").html(html);
    }

    /* =========================================================
       GRÁFICOS
       ========================================================= */

    function pintarAdminHistorico(datos) {
        if (!datos || datos.length === 0) {
            mostrarErrorHistorico(
                "No existen datos históricos para mostrar."
            );
            return;
        }

        var serieCobranza = [];
        var serieDesembolso = [];
        var serieFlujo = [];
        var ticks = [];

        $.each(datos, function (index, item) {
            serieCobranza.push([
                index,
                numeroSeguro(item.Cobrado)
            ]);

            serieDesembolso.push([
                index,
                numeroSeguro(item.Desembolsado)
            ]);

            serieFlujo.push([
                index,
                numeroSeguro(item.FlujoOperativo)
            ]);

            if (index % 4 === 0 || index === datos.length - 1) {
                ticks.push([
                    index,
                    formatearFechaCorta(item.Fecha)
                ]);
            }
        });

        $("#graficoAdminHistoricoError").hide();
        $("#graficoAdminHistorico").show();

        $.plot(
            $("#graficoAdminHistorico"),
            [
                crearSerieLinea("Cobranza", serieCobranza, 2),
                crearSerieLinea("Desembolsos", serieDesembolso, 2),
                crearSerieLinea("Flujo operativo", serieFlujo, 2)
            ],
            crearOpcionesGrafico(ticks)
        );

        vincularTooltipGrafico(
            "#graficoAdminHistorico",
            datos,
            function (registro) {
                return formatearFechaCompleta(registro.Fecha);
            }
        );
    }

    function pintarAdminHistoricoMensual(datos) {
        if (!datos || datos.length === 0) {
            mostrarErrorHistoricoMensual(
                "No existen datos mensuales para mostrar."
            );
            return;
        }

        var serieCobranza = [];
        var serieDesembolso = [];
        var serieFlujo = [];
        var ticks = [];

        $.each(datos, function (index, item) {
            serieCobranza.push([
                index,
                numeroSeguro(item.Cobrado)
            ]);

            serieDesembolso.push([
                index,
                numeroSeguro(item.Desembolsado)
            ]);

            serieFlujo.push([
                index,
                numeroSeguro(item.FlujoOperativo)
            ]);

            var etiqueta = formatearMesCorto(item.FechaMes);

            if (item.EsMesActual) {
                etiqueta += " *";
            }

            ticks.push([index, etiqueta]);
        });

        $("#graficoAdminMensualError").hide();
        $("#graficoAdminMensual").show();

        $.plot(
            $("#graficoAdminMensual"),
            [
                crearSerieLinea("Cobranza", serieCobranza, 3),
                crearSerieLinea("Desembolsos", serieDesembolso, 3),
                {
                    label: "Flujo operativo",
                    data: serieFlujo,
                    bars: {
                        show: true,
                        barWidth: 0.45,
                        align: "center"
                    }
                }
            ],
            crearOpcionesGrafico(ticks)
        );

        vincularTooltipGrafico(
            "#graficoAdminMensual",
            datos,
            function (registro) {
                var etiqueta =
                    formatearMesCompleto(registro.FechaMes);

                if (registro.EsMesActual) {
                    etiqueta += " - parcial";
                }

                return etiqueta;
            }
        );
    }

    function crearSerieLinea(nombre, datos, radio) {
        return {
            label: nombre,
            data: datos,
            lines: {
                show: true,
                lineWidth: 2
            },
            points: {
                show: true,
                radius: radio
            }
        };
    }

    function crearOpcionesGrafico(ticks) {
        return {
            series: {
                shadowSize: 0
            },

            grid: {
                borderWidth: 1,
                hoverable: true,
                clickable: false,
                mouseActiveRadius: 12
            },

            xaxis: {
                ticks: ticks
            },

            yaxis: {
                tickFormatter: formatearEjeMoneda
            },

            legend: {
                show: true,
                position: "nw"
            }
        };
    }

    function formatearEjeMoneda(valor) {
        valor = numeroSeguro(valor);

        if (Math.abs(valor) >= 1000000) {
            return "S/ " +
                (valor / 1000000).toFixed(1) +
                "M";
        }

        if (Math.abs(valor) >= 1000) {
            return "S/ " +
                (valor / 1000).toFixed(0) +
                "k";
        }

        return "S/ " + valor.toFixed(0);
    }

    /*
        IMPORTANTE:
        Flot entrega las coordenadas reales del punto en item.pageX/item.pageY.
        El evento "plothover" es sintético y no debe usarse como fuente
        de pageX/pageY.
    */
    function vincularTooltipGrafico(selector, datos, obtenerEtiqueta) {
        var $grafico = $(selector);

        $grafico
            .unbind("plothover.adminTooltip")
            .bind("plothover.adminTooltip", function (event, pos, item) {
                if (!item) {
                    ocultarTooltipGrafico();
                    return;
                }

                var indice = item.dataIndex;

                if (indice < 0 || indice >= datos.length) {
                    ocultarTooltipGrafico();
                    return;
                }

                var registro = datos[indice];
                var serie = item.series && item.series.label
                    ? item.series.label
                    : "";

                var valor = numeroSeguro(item.datapoint[1]);

                mostrarTooltipGrafico(
                    $grafico,
                    event,
                    item,
                    obtenerEtiqueta(registro),
                    serie,
                    valor
                );
            });

        $grafico
            .unbind("mouseleave.adminTooltip")
            .bind("mouseleave.adminTooltip", ocultarTooltipGrafico);
    }

    /*
        El tooltip se posiciona DENTRO de la tarjeta de la gráfica.
        Así nunca aumenta el ancho del documento ni se pierde fuera
        del borde derecho. Además usamos event.pageX/pageY como
        respaldo para versiones antiguas de Flot que no expongan
        item.pageX/item.pageY.
    */
    function mostrarTooltipGrafico(
        $grafico,
        event,
        item,
        fecha,
        serie,
        valor) {

        var pageX =
            item && typeof item.pageX === "number"
                ? item.pageX
                : (event && typeof event.pageX === "number"
                    ? event.pageX
                    : null);

        var pageY =
            item && typeof item.pageY === "number"
                ? item.pageY
                : (event && typeof event.pageY === "number"
                    ? event.pageY
                    : null);

        if (pageX === null || pageY === null) {
            ocultarTooltipGrafico();
            return;
        }

        var $card = $grafico.closest(".admin-chart-card");

        if (!$card.length) {
            $card = $grafico.parent();
        }

        var $tooltip = $("#adminChartTooltip");

        /*
            El mismo tooltip sirve para ambas gráficas. Lo movemos
            a la tarjeta activa para que position:absolute tome
            esa tarjeta como referencia.
        */
        if (!$tooltip.parent().is($card)) {
            $tooltip.appendTo($card);
        }

        var valorFormateado =
            serie === "Flujo operativo"
                ? formatoMonedaConSigno(valor)
                : formatoMoneda(valor);

        $tooltip
            .html(
                '<span class="admin-chart-tooltip-date">' +
                    escaparHtml(fecha) +
                "</span>" +
                '<span class="admin-chart-tooltip-serie">' +
                    escaparHtml(serie) +
                "</span>" +
                '<span class="admin-chart-tooltip-value">' +
                    escaparHtml(valorFormateado) +
                "</span>"
            )
            .css({
                left: 0,
                top: 0,
                visibility: "hidden"
            })
            .show();

        var margen = 12;
        var margenBorde = 8;

        var offsetCard = $card.offset();
        var puntoX = pageX - offsetCard.left;
        var puntoY = pageY - offsetCard.top;

        var anchoTooltip = $tooltip.outerWidth();
        var altoTooltip = $tooltip.outerHeight();

        var anchoCard = $card.innerWidth();
        var altoCard = $card.innerHeight();

        var left = puntoX + margen;
        var top = puntoY + margen;

        /* Si no entra a la derecha, se abre a la izquierda. */
        if (left + anchoTooltip + margenBorde > anchoCard) {
            left = puntoX - anchoTooltip - margen;
        }

        /* Nunca permitimos que salga por la izquierda. */
        if (left < margenBorde) {
            left = margenBorde;
        }

        /* Si no entra abajo, se abre sobre el punto. */
        if (top + altoTooltip + margenBorde > altoCard) {
            top = puntoY - altoTooltip - margen;
        }

        /* Nunca permitimos que salga por arriba. */
        if (top < margenBorde) {
            top = margenBorde;
        }

        $tooltip.css({
            left: Math.round(left),
            top: Math.round(top),
            visibility: "visible"
        });
    }

    function ocultarTooltipGrafico() {
        $("#adminChartTooltip").hide();
    }

