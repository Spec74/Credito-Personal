@model VendixWeb.Controllers.DatosCredito
<style>
    .BordeSeleccion {
        border: 1px solid green;
    }
    .riesgo-sbs-0 { background-color: #28a745; color: white; padding: 2px 5px; border-radius: 3px; } /* Normal - Verde */
    .riesgo-sbs-1 { background-color: #ffc107; color: black; padding: 2px 5px; border-radius: 3px; } /* CPP - Amarillo */
    .riesgo-sbs-2 { background-color: #fd7e14; color: white; padding: 2px 5px; border-radius: 3px; } /* Deficiente - Naranja */
    .riesgo-sbs-3 { background-color: #dc3545; color: white; padding: 2px 5px; border-radius: 3px; } /* Dudoso - Rojo */
    .riesgo-sbs-4 { background-color: #000000; color: white; padding: 2px 5px; border-radius: 3px; } /* Pérdida - Negro */
</style>

<div class="grid_12 profile">
    <div class="header">
        <div class="title">
            @if (Model != null)
            {
                <h2>
                    <a target="_blank" href="@Url.Action("ReporteCliente","Reporte")?pPersonaId=@Model.Persona.PersonaId">
                        @Model.Persona.NumeroDocumento - @Model.Persona.NombreCompleto
                    </a>

                </h2>
                <h3>
                    @Model.EstadoCliente                    
                </h3>
                <h2>
                    @if (!string.IsNullOrEmpty(Model.ClasificacionRiesgoSBS))
                    {
                        string claseRiesgo = "riesgo-sbs-" + Model.ClasificacionRiesgoSBS;
                        string textoRiesgo = "";
                        switch (Model.ClasificacionRiesgoSBS)
                        {
                            case "0": textoRiesgo = "NORMAL"; break;
                            case "1": textoRiesgo = "CPP"; break;
                            case "2": textoRiesgo = "DEFICIENTE"; break;
                            case "3": textoRiesgo = "DUDOSO"; break;
                            case "4": textoRiesgo = "PÉRDIDA"; break;
                        }
                        <span class="@claseRiesgo" title="@Model.ClasificacionRiesgoSBSObs" style="margin-left: 10px; font-size: 1.2em;">
                            SBS: @textoRiesgo
                        </span>
                    }
                </h2>
                <div class="right" style="padding:15px">
                    @if (ViewBag.Depurado == null)
                    {
                        //if (ViewBag.Aprobador1 > 0)
                        //{
                            <button class="grey" id="btnDepurarCliente">Depurar</button>
                        //}
                    }
                    else
                    {
                        <div class="alert error sticky no-margin">
                            <span class="icon"></span>
                            <strong>DEPURADO!</strong> @ViewBag.Depurado
                        </div>
                    }
                </div>
            }
        </div>
        <div class="avatar">
            <img src="~/img/elements/profile/avatar.png" />
            <a class="abrir-buscarCliente block">Buscar Cliente</a>
        </div>

        <ul class="info">
            <li>
                <strong style="font-size:40px">
                    @if (Model != null)
                    {@Model.Persona.Codigo}
                </strong>
            </li>
            <li>
                <strong>
                    @if (Model != null)
                    {
                        @Model.TotalCreditos
                    }
                    else
                    {
                        <text>0</text>
                    }
                </strong>
                <small>Total Créditos</small>
            </li>
            <li>
                <strong>
                    @if (Model != null && Model.Creditos != null)
                    {
                        @Model.Creditos.Count
                    }
                    else
                    {
                        <text>0</text>
                    }
                </strong>
                <small>Créditos Pendientes</small>

            </li>
            <li>
                <strong style="font-size:40px">
                    @if (Model != null)
                    {@Model.Cliente.Calificacion}
                </strong>
            </li>
            <li>
                @if (Model != null && Model.Creditos != null)
                {
                    if (!Model.Cliente.Bloqueado && ViewBag.Depurado == null)
                    {
                        if (Model.lectura == false)
                        {
                            <button id="btnCrearSolicitud">Crear Solicitud de Crédito</button>
                        }
                    }
                }
            </li>
        </ul>
    </div>
