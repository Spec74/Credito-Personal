            function apiPeruHeaders() {
                var token = window.localStorage ? window.localStorage.getItem('credito.access') : null;
                return token ? { 'Authorization': 'Bearer ' + token } : {};
            }

            function apiPeruDniUrl(dni) {
                return "/api/v1/integraciones/apiperu/dni/" + encodeURIComponent((dni || '').replace(/\D/g, ''));
            }

