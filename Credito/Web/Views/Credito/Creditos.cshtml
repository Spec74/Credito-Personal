            function CalcularMontoCondonar(){
                var deuda =  parseFloat($.data(document.body, 'cDeuda'));
                var deudacapital = $.data(document.body, 'cDeudaCapital');
                var deudainteres = $.data(document.body, 'cDeudaInteres');
                var deudaMoras = $.data(document.body, 'cDeudaMoras');
                var deudaCargos = $.data(document.body, 'cDeudaCargos');

                var capital = 0;
                var interes = 0;
                var cargo = 0;
                var moras = 0;

                if ($("#chkcCapital").prop('checked')) {
                    if (parseFloat($('#txtcCondonarCapital').val()) > deudacapital)
                        $('#txtcCondonarCapital').val(deudacapital.toFixed(2));
                    capital = parseFloat($('#txtcCondonarCapital').val()) ;
                }
                if ($("#chkcInteres").prop('checked')) {
                    if (parseFloat($('#txtcCondonarInteres').val()) > deudainteres)
                        $('#txtcCondonarInteres').val(deudainteres.toFixed(2));
                    interes = parseFloat($('#txtcCondonarInteres').val()) ;
                }
                if ($("#chkcCargos").prop('checked')) {
                    if (parseFloat($('#txtcCondonarCargos').val()) > deudaCargos)
                        $('#txtcCondonarCargos').val(deudaCargos.toFixed(2));
                    cargo = parseFloat($('#txtcCondonarCargos').val()) ;
                }
                if ($("#chkcMoras").prop('checked')) {
                    if (parseFloat($('#txtcCondonarMoras').val()) > deudaMoras)
                        $('#txtcCondonarMoras').val(deudaMoras.toFixed(2));
                    moras = parseFloat($('#txtcCondonarMoras').val()) ;
                }

                var m = deuda - capital - interes  - cargo - moras;
                $.data(document.body, 'cDeudaCondonarCXC',m);
                $.data(document.body, 'cDeudaObs','DEUDA('+deuda.toFixed(2)+')=CAPITAL('+deudacapital.toFixed(2)+')+INTERES('+deudainteres.toFixed(2)+')+MORAS('+deudaMoras.toFixed(2)+')+CARGOS('+deudaCargos.toFixed(2)+')' + ' ==> PAGO CONDONACION ('+m.toFixed(2)+') ==>CAPITAL('+capital.toFixed(2)+') INTERES('+interes.toFixed(2)+') MORAS('+moras.toFixed(2)+') CARGOS('+cargo.toFixed(2)+')' );
                $.data(document.body, 'cMontoCondonacion',interes + cargo + moras);
                $("#lblcCxcCondonar").text(m.toFixed(2));

            }

