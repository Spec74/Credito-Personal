        <script>
            $(function () {
                $("#txtInteres,#txtGa").numeric(2);
                $("#txtNroCuotas").numeric();
                $("#lblInteresRango").data("min", @Model.Producto.InteresMinima);
                $("#lblInteresRango").data("max", @Model.Producto.InteresMaxima);

                $("#txtMontoCredito").numeric(2)
                    .keyup(function (event) {
                        if (event.which == 13) {
                            event.preventDefault();
                        }
                        CalcularGastosAdm();
                    });
                $("#txtInteres").blur(function () {
                    var num = parseFloat($(this).val());
                    var max = $("#lblInteresRango").data("max");
                    var min = $("#lblInteresRango").data("min");
                    if (num < min || num > max) {
                        $(this).val(max.toFixed(2));
                        Vendix.Mensaje("El Interes debe estar entre " + min.toFixed(2) + " y " + max.toFixed(2));
                    }
                });
                $("#chkcCentralRiesgo").change(function () {
                    CalcularGastosAdm();
                });
                $("#cboProducto").change(function () {
                    $.ajax({
                        url: "@Url.Action("ObtenerProducto", "Credito")",
                        data: { pProductoId: $(this).val() },
                        success: function (ret) {
                            var max = parseFloat(ret.InteresMaxima);
                            var min = parseFloat(ret.InteresMinima);
                            var interesDef = 8;
                            if (interesDef>=min && interesDef<=max) {
                                $("#txtInteres").val(interesDef.toFixed(2));
                            }else
                                $("#txtInteres").val(interesDef.toFixed(2));

                            $("#lblInteresRango").text("Interes Min: " + min.toFixed(2) + " Max: " + max.toFixed(2));
                            $("#lblInteresRango").data("min", min);
                            $("#lblInteresRango").data("max", max);

                            //$("#lblImpMoratorio").text("Importe Moratorio" + ret.ImporteMoratorio);
                            //$("#lblDiasGracia").text("Días de Gracia" + ret.DiasGracia);
                            CalcularGastosAdm();
                        }
                    });
                });
                $("#cboFormaPago").change(function () {
                    $.ajax({
                        url: "@Url.Action("ObtenerFechaPrimerPago", "Credito")",
                        data: { pModalidad: $(this).val() },
                        success: function (ret) {
                            //alert(ret);
                            $("#txtFechappSol").val(ret);
                        }
                    });
                });
                $("#cboFormaPago").trigger("change");

                $("#cboGA").change(function () {
                    CalcularDesembolso();
                });
                $("#txtGa")
                   .keyup(function (event) {
                       if (event.which == 13) {
                           event.preventDefault();
                       }
                       CalcularDesembolso();
                   }).blur(function(){ CalcularDesembolso();});
            });
            function CalcularDesembolso(){
                var m = parseFloat( $("#txtMontoCredito").val());
                var ga = parseFloat( $("#txtGa").val());
                if ($('#cboGA').val()=='CAP')
                    $('#lblMontoDesemb').text('MONTO A DESEMBOLSAR: ' + parseFloat(m-ga).toFixed(2) );
                else
                    $('#lblMontoDesemb').text('MONTO A DESEMBOLSAR: ' + m.toFixed(2) );
            }

            function CalcularGastosAdm() {
                $.ajax({
                    url: "@Url.Action("CalcularGastosAdm", "Credito")",
                    data: {
                        pProductoId: 1,
                        pMonto: $("#txtMontoCredito").val(),
                        pIncluyeCentralRiesgo: $("#chkcCentralRiesgo").prop('checked')
                    },
                    success: function (ret) {
                        $("#txtGa").val(ret.toFixed(2));
                        CalcularDesembolso();
                    }
                });
            }

        </script>
    }
