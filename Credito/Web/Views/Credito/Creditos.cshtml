                $("#chkcInteres").change(function () {
                    $("#chkcInteres").prop('checked')?$("#txtcCondonarInteres").show().focus():$("#txtcCondonarInteres").hide();
                    CalcularMontoCondonar();
                });
                $("#chkcCargos").change(function () {
