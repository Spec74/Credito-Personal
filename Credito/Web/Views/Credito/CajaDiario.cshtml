							{ name: 'PagoCuota', index: 'PagoCuota', align: 'center', width: 100 }
						],
                    caption: "Cuotas Pendientes",
                    pager: jQuery('#grdpBuscar'),
                    rowNum: 100,
                    rowList: [100, 125, 150],
                    sortorder: "asc",
                    gridview: true,
                    viewrecords: true,
                    rownumbers: true,
                    autowidth: true,
                    //paging: true,
                    width: 'auto',
                    height: '351px',
                    //recordpos: 'right',
                    multiselect: true,
                    onSelectRow: function (id) { CalcularMontoCuota(); },
                    onSelectAll: function (aRowids, isSelected) { CalcularMontoCuota(); },
                    footerrow: true,
                    loadComplete: function () {

                        let totalcuotas = $(this).jqGrid('getCol', 'PlanPagoId', false, 'count');
                        let totalPagoCuota = $(this).jqGrid('getCol', 'PagoCuota', false, 'sum');
                        let totalAmortizacion = $(this).jqGrid('getCol', 'Amortizacion', false, 'sum');
                        let totalCuota = $(this).jqGrid('getCol', 'Cuota', false, 'sum');
                        let totalMora = $(this).jqGrid('getCol', 'ImporteMora', false, 'sum');
                        let totalInteres = $(this).jqGrid('getCol', 'Interes', false, 'sum');
                        $(this).jqGrid("footerData", "set", {
                            Glosa: "Cuotas Pendientes: " + (totalcuotas -1),
                            FechaVencimiento: "Pendiente:",
                            Amortizacion: parseFloat(totalAmortizacion).toFixed(2),
                            Interes: parseFloat(totalInteres).toFixed(2),
                            Cuota: parseFloat(totalCuota).toFixed(2),
                            ImporteMora: parseFloat(totalMora).toFixed(2),
                            PagoCuota: parseFloat(totalPagoCuota).toFixed(2)

                        });
                        $.data(document.body, 'TotalPagoCuota', parseFloat(totalPagoCuota).toFixed(2));


                    }
                }).jqGrid('bindKeys', {
                    "onEnter": function (rowid) { /*mostrardetalle();*/
                    }
                });
            }
        }
        function CalcularMontoCuota() {
            var suma = 0;
            var arr = jQuery("#grdBuscar").jqGrid('getGridParam', 'selarrrow');
            if (arr.length == 0) {
                $.data(document.body, 'PlanPagoId', '');
                $("#lblMontoPago").text("0.00");
                return;
            }
            $.each(arr, function (key, value) {
                var ret = $("#grdBuscar").jqGrid('getRowData', value);
                suma += parseFloat(ret.PagoCuota);
            });
            $.data(document.body, 'PlanPagoId', arr.join(","));
            $("#lblMontoPago").text(parseFloat(suma).toFixed(2));
            $("#txtImporteRecibido").trigger("keyup").select().focus();
        }

