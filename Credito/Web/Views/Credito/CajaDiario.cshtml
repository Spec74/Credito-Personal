@model ITB.VENDIX.DA.CajaDiario


@if (Model != null)
{
    <style>
        .BordeSeleccion {
            border-style: dashed;
            border-width: 4px;
        }
    </style>
    <ul class="stats not-on-phone">
        <li class="saldos">
            <strong>@Model.SaldoInicial</strong>
            <span class="green">Saldo Inicial(S/.)</span>
        </li>
        <li class="saldos">
            <strong>
                <label id="lblEntradas">@String.Format("{0:0.00}", Model.Entradas)</label>
            </strong>
            <span class="green">Entradas(S/.)</span>
        </li>
        <li class="saldos">
            <strong>
                <label id="lblSalidas">@String.Format("{0:0.00}", Model.Salidas)</label>
            </strong>
            <span class="green">Salidas(S/.)</span>
        </li>
        <li class="saldos">
            <strong>
                <label id="lblSaldoFinal">@Model.SaldoFinal</label>
            </strong>
            <span class="red">Neto Caja(S/.)</span>
        </li>
        <li>
            <strong>@(Model.IndCierre ? "CERRADO" : "ABIERTO")</strong>
            <small>@Model.FechaIniOperacion</small>
            <span style="cursor: pointer" id="lblMostrarSaldos">@Model.Caja.Denominacion</span>
        </li>
    </ul>
    
    <div class="grid_12">
        <div class="alert note sticky no-margin">
            <span class="icon"></span>
            <strong><label id="lblResumenCuenta">@ViewBag.ResumenCuentaCajadiario</label></strong>
        </div>
        <br />
        <div class="box tabbedBox">
            <div class="header">
                <h2>MOVIMIENTOS @Model.Caja.Denominacion</h2>
                <ul>
                    <li><a href="#t1-c1">COBRANZAS</a></li>
                    <li><a href="#t1-cd">DESEMBOLSOS</a></li>
                    <li><a href="#t1-c2">EGRESO-INGRESO</a></li>
                    <li><a href="#t1-c3">ARQUEO</a></li>
                </ul>
            </div>
            <br />
            <div id="tabcaja" class="content tabbed">
                <div id="t1-c1">
                    <div class="grid_12">
                        <p class="_50 small">
                            <input id="txtCliente" type="search" placeholder="BUSCAR CLIENTE POR DNI Y NOMBRES" style="width: 95%" autofocus />
                        </p>
                        <p class="_50 small">
                            <button id="btnCxcPendiente" class="inline"><span class="icon icon-repeat"></span>GAD Pendientes</button>
                            <button id="btnCuotaPendiente" class="inline"><span class="icon icon-repeat"></span>Cuotas Pendientes</button>
                            <button id="btnCompletarCoutaPendienteImpago" class="inline">Completar Impagos</button>

                        </p>
                        @*<div class="msjClienteEncontrado" style="display: none; margin: 0">
                            <div class="alert success sticky ">
                                <span class="icon"></span><strong>Encontrado!</strong>
                                <label id="lblCliente"></label>
                            </div>
                        </div>*@
                        <div class="spacer"></div>
                    </div>

                    <div id="divCxC" class="grid_12 box">
                        <div class="header ">
                            <h2>
                                <img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />
                                CUENTAS POR COBRAR [<label id="lblcxcCliente"></label>]
                            </h2>
                        </div>

                        <table id="grdcxc"></table>
                        <div id="grdpcxc"></div>

                        <div id="actCxC" class="actions " style="display: none">
                            <div class="right">
                                <a id="btnPagoCxC" class="button">Pagar Cuenta</a>
                            </div>
                        </div>
                    </div>


                    <div class="box grid_12 msjCreditoEncontrado">

                        <div class="header">
                            <h2>
                                <img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />
                                CREDITO  [ <label id="lblCreditoActual"></label> ] <label style="font-size:large" id="lblCreditoCliente"></label>
                            </h2>
                        </div>
                        <div class="msjCreditoEncontrado" style='display: none; background: #f0f1f4'>
                            <br />
                            <div class="grid_4 center-elements" id="divbtncreditos"></div>

                            <div class="grid_5 center-elements ">
                                <span class="badge block dark">
                                    PAGO LIBRE:
                                    <input id="txtPagoLibre" type="text" style="font-size:small; text-align: right; width: 80px;  " />
                                    <button id="btnPagoLibre" class="button red block"><span class="icon icon-list"></span>Pago Libre</button>
                                </span>
                            </div>
                            <div class="grid_2">
                                <div style="margin-top:15px">
                                    @Html.DropDownList("cboTipoPago", (IEnumerable<SelectListItem>)ViewBag.cboTipoPago)
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                        <table id="grdBuscar"></table>
                        <div id="grdpBuscar"></div>
                        <div class="actions msjCreditoEncontrado" style="display: none">
                            <span class="badge block dark" style="float: right">
                                TOTAL: <span id="lblMontoPago">0.00</span> Recibido:
                                <input id="txtImporteRecibido" type="text" style="font-size:small; text-align: right; width: 80px; " />
                                VUELTO: <span id="lblvuelto">0.00</span>
                                <button id="btnPagar" class="button red block"><span class="icon icon-ok"></span>Pagar Couta</button>
                            </span>
                        </div>
                    </div>

                    <div class="box grid_12 msjCreditoEncontrado" style="display: none">
                        <div class="actions" id="divCancelarCreditoShow">
                            <button id="btnCancelarCreditoShow" class="button red block"><span class="icon icon-legal"></span>Cancelar Crédito</button>
                        </div>
                        <div class="CancelarCredito">
                            <table id="grdCancelarCredito"></table>
                            <div id="grdpCancelarCredito"></div>
                        </div>
                        <div class="actions CancelarCredito" style="display: none">
                            <button id="btnCancelarCredito" class="button red block" style="float: right"><span class="icon icon-ok"></span>Cancelar Crédito</button>
                        </div>
                    </div>

                </div>
                <div id="t1-cd">
                    <div class="grid_10">
                        <p class="_75 small">
                            <input id="txtClienteds" type="search" placeholder="BUSCAR CLIENTE POR DNI Y NOMBRES" style="width: 95%" />
                        </p>
                        <p class="_25 small">
                            <button id="btnDesembolsoPendiente" class="inline"><span class="icon icon-repeat"></span>Pendientes</button>
                        </p>
                        @*<div class="msjClienteEncontradods" style="display:none" >
                            <div class="alert success sticky " >
                                <span class="icon"></span><label>Encontrado!</label>
                                <label id="lblClienteds"></label>
                            </div>
                        </div>*@
                        <div class="spacer"></div>
                        <div id="divdesembolso" class="grid_12 box">
                            <div class="header ">
                                <h2><img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />DESEMBOLSO</h2>
                            </div>

                            <table id="grdDesembolso"></table>
                            <div id="grdpDesembolso"></div>

                            <div id="actDesembolso" class="actions " style="display: none">
                                <div class="right">
                                    <button id="btnDesembolso" class="submit">Desembolsar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div id="t1-c2">
                    <p class="_50 small">
                        <label>Persona:</label>
                        <input id="txtPersonaES" type="search" placeholder="BUSCAR PERSONA" />
                    </p>
                    @*<p class="_25 small">
                        <label>Tipo:</label>
                        <select id="cboEgresoIngreso">
                            <option value="0">EGRESO</option>
                            <option value="1">INGRESO</option>
                        </select>
                    </p>*@
                    <p class="_25 small">
                        <label>Operación:</label>
                        @Html.DropDownList("cboTipoOperacion", (IEnumerable<SelectListItem>)ViewBag.cboTipoOperacion)
                    </p>
                    <p class="_25 small">
                        <label>Tipo:</label>
                        @Html.DropDownList("cboTipoPagoEI", (IEnumerable<SelectListItem>)ViewBag.cboTipoPagoEI)
                    </p>


                    <p class="_50 small">
                        <label>Descripcion:</label>
                        <input id="txtDescripcionSalida" type="text" />
                    </p>
                    <p class="_25 small">
                        <label>Importe:</label>
                        <input id="txtImporteSalida" type="text" style="text-align: center" />
                    </p>
                    <p class="_25 small" style="margin-top:20px">

                        <a id="btnPagarSalida" class="button red center">Realizar Operación</a>
                    </p>
                </div>

                <div id="t1-c3">
                    <table id="grdEntradas"></table>
                    <div id="grdpEntradas"></div>
                    <br />
                    <table id="grdSalidas"></table>
                    <div id="grdpSalidas"></div>
                    <br />
                    <button id="btnPrevSaldoCaja" class="button block"><span class="icon icon-print"></span>Previzualizar Saldo Caja</button>
                    <button id="btnCerrar" style="float: right" class="button red block"><span class="icon icon-play"></span>Cerrar Caja</button>
                    @if (ViewBag.EsCajaCentral)
                    {
                        <button id="btnConciliar" style="float: right" class="button green block"><span class="icon icon-play"></span>Conciliar Pagos</button>
                    }
                    <button id="btnTransFerirSaldos" style="float: right" class="button green block"><span class="icon icon-play"></span>Transferir Saldos</button>
                    <span class="badge block blue dark" style="font-size: large;float: right">TOTAL CAJA: S/. <span id="lblNetoArq">0.00</span></span>
                </div>

            </div>

        </div>


        <a href="@Url.Action("ReporteCobroDiario", "Reporte")" class="button block" target="_blank"><span class="icon icon-print"></span>Cobros del Dia PDF</a>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

        <button id="btnMovimientosCaja" class="inline"><span class="icon icon-repeat"></span>Movimientos</button>
    </div>

    <div style="display: none;" id="dlgTransferirBoveda" title="Transferencias">
        <form class="full validate">
            <div class="row">
                <label>
                    <strong>Transferencia:</strong>
                </label>
                <div>
                    <table>
                        <tr>
                            <td>
                                <input type="radio" name="rbTipoTransferencia" id="rbCaja" value="caja" checked="checked" /><label for="rbCaja"> CAJA</label>  &nbsp;&nbsp;
                                <input type="radio" name="rbTipoTransferencia" id="rbBoveda" value="boveda" /><label for="rbBoveda">BOVEDA</label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row Caja">
                <label for="cboCajas">
                    <strong>Caja :</strong>
                </label>
                <div>
                    @Html.DropDownList("cboCajas", (IEnumerable<SelectListItem>)ViewBag.cboCajas)
                </div>
            </div>
            <div class="row">
                <label for="txtMontoTransferencia">
                    <strong>Monto:</strong>
                </label>
                <div>
                    <strong><span id="lblMensaje" style="color:red"></span></strong><br />
                    <span><strong>Monto total de Caja : S/.  <span id="lblMontoCaja" style="color:blue"></span></strong></span>
                    <input type="number" id="txtMontoTransferencia" placeholder="0.00" />
                </div>
            </div>

            <div class="row">
                <label for="txtDescripcionTransferencia">
                    <strong>Descripción :</strong>
                </label>
                <div>
                    <input type="text" id="txtDescripcionTransferencia" placeholder="Descripcion de transferencia" />
                </div>
            </div>

        </form>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
            <div class="right">
                <input id="btnEnviar" type="button" value="Guardar" />
            </div>
        </div>
    </div>

    <div style="display: none;" id="dlgCxcPendiente" title="Cuotas Pendientes">
        <div class="actions">
            <table id="grdCxcPendiente"></table>
            <div id="grdpCxcPendiente"></div>
        </div>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
        </div>
    </div>
    <div style="display: none;" id="dlgConfirmarClave" title="Autorización">
        <div class="actions">
            <form class="full validate">
                <div class="row">
                    <div>
                        <input type="password" id="txtConfirmarClave" placeholder="Clave" />
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
            <div class="right">
                <input id="btnConfirmarClave" type="button" value="Confirmar" />
            </div>
        </div>
    </div>
    <div style="display: none;" id="dlgFechaHoraMovimiento" title="Fecha Hora de Transferencia">
        <div class="actions">
            <form class="full validate">
                <div class="row">
                    <label for="f3_datepicker">
                        <strong>Fecha y Hora</strong>
                    </label>
                    <div>
                        <input type="datetime" name="txtFechaHoraTransaccion" id="txtFechaHoraTransaccion" />
                    </div>
                </div>
            </form>
        </div>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
            <div class="right">
                <input id="btnFechaHoraMovimiento" type="button" value="Confirmar" />
            </div>
        </div>
    </div>
    <div style="display: none;" id="dlgMovimientosCaja" title="Movimientos Caja">
        <form class="full validate">
            <p class="_75 small">
                <input data-error-type="inline" type="text" id="txtBuscarClienteMovCaja" placeholder="Buscar Cliente" />
            </p>
            <p class="_25 small">
                <button id="btnBuscarMovimientoCaja" class="red">Buscar</button>
            </p>
        </form>
        <div class="actions">
            <table id="grdMovimientosCaja"></table>
            <div id="grdpMovimientosCaja"></div>
        </div>
        <div class="actions">
            <div class="left">
                <button class="grey cancel">Salir</button>
            </div>
        </div>
    </div>

    <script>
        $(function () {
            $.data(document.body, 'PersonaId', 0);
            $.data(document.body, 'PersonaESid', 0);
            $("#txtImporteSalida").numeric(2);
            $("#txtFechaHoraTransaccion").mask("99/99/9999 99:99")

            $("#rbBoveda,#rbCaja").change(function () {
                $(".Caja").hide();
                $(".Boveda").hide();

                if ($("#rbCaja").prop('checked')) {
                    $(".Caja").show();
                }
                else {
                    $(".Boveda").show();
                }
            });

            $("#txtPagoLibre")
				.numeric(2)
				.keypress(function (event) {
				    if (event.which == 13) {
				        $("#btnPagoLibre").trigger("click");
				    }
				    $("#btnPagoLibre").prop('disabled', false);
				});

            $('#lblMostrarSaldos').click(function () {
                $('.saldos').toggle();
            });


            $("#btnPrevSaldoCaja").click(function () {
                event.preventDefault();
                var ruta = '@Url.Action("ReporteSaldoCajaActual", "Reporte")';
                window.open(ruta);
                return false;
            });

            $('a[href="#t1-c3"]').click(function () {
                $("#grdEntradas,#grdSalidas").jqGrid('setGridParam', { page: 1 }).trigger("reloadGrid");
                $("#grdEntradas,#grdSalidas").setGridWidth($('#tabcaja').width() - 3, true);
                $("#lblNetoArq").text($("#lblSaldoFinal").text());
            });
            $("#dlgCxcPendiente").dialog({
                autoOpen: false,
                modal: true,
                width: 650,
                open: function () {
                    $(this).parent().css('overflow', 'visible');
                    $$.utils.forms.resize();
                }
            }).find('button.cancel').click(function () {
                var $el = $(this).parents('.ui-dialog-content');
                //$el.find('form')[0].reset();
                $el.dialog('close');
            });
            $("#btnCxcPendiente").click(function () {
                event.preventDefault();
                $.data(document.body, 'PersonaId', 0);
                CargarGrillaCxc();
            });

            $("#dlgMovimientosCaja").dialog({
                autoOpen: false,
                modal: true,
                width: 650,
                open: function () {
                    $(this).parent().css('overflow', 'visible');
                    $$.utils.forms.resize();
                }
            }).find('button.cancel').click(function () {
                var $el = $(this).parents('.ui-dialog-content');
                //$el.find('form')[0].reset();
                $el.dialog('close');
            });

            $("#btnMovimientosCaja").click(function () {
                event.preventDefault();
                $('#txtBuscarClienteMovCaja').val("");
                $.data(document.body, 'PersonaIdMovCaja', 0);

                if ($("#gbox_grdMovimientosCaja").length > 0)
                    $("#grdMovimientosCaja").trigger("reloadGrid");
                else {
                    $("#grdMovimientosCaja").jqGrid({
                        url: "@Url.Action("ListarMovimientoCajaGrd", "CajaDiario")",
                        datatype: "json",
                        postData: {
                            filters: function () {
                                return $.toJSON([{ Key: "PersonaId", Value: $.data(document.body, 'PersonaIdMovCaja') }]);
                            }
                        },
                        colNames: ['Id', 'Imprimir', 'Op', 'FechaReg', 'Descripcion', 'Importe', 'Estado'],
                        colModel: [
                            { name: "MovimientoCajaId", index: "MovimientoCajaId", align: "center", width: 40, sortable: false },
                            { name: 'Imprimir', index: 'Imprimir', align: 'center', width: 40, formatter: MovCajaPrintFormatter },
                            { name: "Operacion", index: "Operacion", width: 40, align: "center", sortable: false },
                            { name: "FechaReg", index: "FechaReg", width: 120, sortable: false, align: "center" },
                            { name: "Descripcion", index: "Descripcion", width: 250, sortable: false },
                            { name: "ImportePago", index: "ImportePago", width: 80, align: "center", sortable: false },
                            { name: "Estado", index: "Estado", align: "center", width: 70, sortable: false }
                        ],
                        caption: "Movimientos de Caja",
                        pager: $('#grdpMovimientosCaja'),
                        rowNum: 20,
                        rowList: [20, 40, 60],
                        sortname: 'MovimientoCajaId',
                        sortorder: "desc",
                        viewrecords: true,
                        rownumbers: true,
                        width: '610',
                        height: '300'
                    });
                }
                $("#dlgMovimientosCaja").dialog('open');
                return false;
            });

            $("#txtBuscarClienteMovCaja").autocomplete({
                source: "@Url.Action("BuscarCliente", "Cliente")",
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();
                    $.data(document.body, 'PersonaIdMovCaja', ui.item.id);
                    $("#txtBuscarClienteMovCaja").val(ui.item.value);
                }
            });
            $("#btnBuscarMovimientoCaja").click(function () {
                event.preventDefault();
                $("#grdMovimientosCaja").trigger("reloadGrid"); return false;
            });

            $("#btnCuotaPendiente").click(function () {
                event.preventDefault();

                if ($("#gbox_grdCxcPendiente").length > 0)
                    $("#grdCxcPendiente").trigger("reloadGrid");
                else {
                    $("#grdCxcPendiente").jqGrid({
                        url: "@Url.Action("ListarCreditoPendienteGrd", "Credito")",
                        datatype: "json",
                        postData: {
                            filters: function () {
                                //return $.toJSON([{ Key: "CreditoId", Value: $.data(document.body, 'CreditoId') }]);
                            }
                        },
                        colNames: ['CreditoId', 'Codigo', 'Cliente', 'Credito', 'PersonaId'],
                        colModel: [
                            { name: "CreditoId", index: "CreditoId", sortable: false, hidden: true },
                            { name: "Codigo", index: "Codigo", width: 120, sortable: false },
                            { name: "Cliente", index: "Cliente", width: 280 },
                            { name: "MontoCredito", index: "MontoCredito", align: "center", sortable: false },
                            { name: "PersonaId", index: "PersonaId", hidden: true }
                        ],
                        caption: "Creditos de Cuotas Pendientes",
                        pager: $('#grdpCxcPendiente'),
                        rowNum: 100,
                        rowList: [50, 100, 150],
                        sortname: 'Cliente',
                        sortorder: "asc",
                        viewrecords: true,
                        rownumbers: true,
                        width: '610',
                        height: '500',
                        ondblClickRow: function () {
                            var id = jQuery("#grdCxcPendiente").jqGrid('getGridParam', 'selrow');
                            if (id) {
                                var ret = $("#grdCxcPendiente").jqGrid('getRowData', id);
                                $("#dlgCxcPendiente").dialog('close');
                                CargarCreditosPendientes(ret.PersonaId, ret.Cliente + ' [ ' + ret.Codigo + ' ]');
                            }
                        }
                    });
                }
                $("#dlgCxcPendiente").dialog('open');
                return false;
            });

            $('#btnCompletarCoutaPendienteImpago').click(function () {
                event.preventDefault();
                Vendix.Dialogo("Desea Completar las cuotas Impagos", "SiNo", function () {
                    $.ajax({
                        url: "@Url.Action("CompletarImpagos", "Credito")",
                        data: {},
                        success: function (retorno) {
                            if (retorno) {
                                Vendix.Notificar();
                            } else
                                Vendix.Mensaje("ERROR: Consulte con sistemas");
                        }
                    });
                });
            });

            $('#btnPagoLibre').click(function () {
                //validar total pago cuota
                var totalpago = $.data(document.body, 'TotalPagoCuota');
                if (parseFloat($("#txtPagoLibre").val()) > parseFloat(totalpago)) {
                    Vendix.Dialogo("El Importe del Pago Libre no debe ser mayor a " + totalpago);
                    return false;
                }
                $("#btnPagoLibre").prop('disabled', true);
                $.ajax({
                    url: "@Url.Action("TieneCxcPendiente", "Credito")",
                    data: {
                        pCreditoId: $.data(document.body, "CreditoIdSelect")
                    },
                    success: function (tienepagospen) {
                        if (tienepagospen == false) {
                            if (parseFloat($("#cboTipoPago").val()) > 1) {
                                var $el = $("#dlgFechaHoraMovimiento");
                                $el.find('form')[0].reset();

                                //const zeroPad = (val) => val.toString().padStart(2, "0");
                                //let odate = new Date();

                                //let year = odate.getFullYear();
                                //let month = zeroPad(odate.getMonth()+1);
                                //let day = zeroPad(odate.getDate());
                                //let hour = zeroPad(odate.getHours());
                                //let mins = zeroPad(odate.getMinutes());

                                @{
                                    var tiempo = ITB.VENDIX.BL.VendixGlobal.GetFecha().ToString("dd/MM/yyyy HH:mm");
                                }

                                $('#dlgFechaHoraMovimiento').dialog('open');
                                //$("#txtFechaHoraTransaccion").val(day + '/' + month + '/' + year + ' ' + hour + ':' + mins);
                                $("#txtFechaHoraTransaccion").val('@tiempo');
                            } else {
                                RealizarPagoLibre();
                            }

                        } else {
                            $("#btnPagoLibre").prop('disabled', false);
                            Vendix.Dialogo("Tiene Cuentas por cobrar pendientes");
                        }

                    }
                });
            });

            function RealizarPagoLibre() {
                Vendix.Dialogo("Desea realizar el pago Libre de " + parseFloat($("#txtPagoLibre").val()).toFixed(2), "SiNo", function () {
                    $.ajax({
                        url: "@Url.Action("PagarCuotasImporteLibre", "Credito")",
                        data: {
                            pCreditoId: $.data(document.body, "CreditoIdSelect"),
                            pImporteLibre: $("#txtPagoLibre").val(),
                            pTipoPagoId: $("#cboTipoPago").val(),
                            pFechaHoraTrans: $("#txtFechaHoraTransaccion").val()
                        },
