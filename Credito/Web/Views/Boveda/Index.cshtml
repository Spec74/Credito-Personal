        // =================================================================
        // NUEVO: INTERACCIÓN DE TARJETA -> APERTURA DEL FLUJO DE ANALISTAS
        // =================================================================
        // A. Inicializar el comportamiento y validación del Modal de Analistas
        $("#dlgTransferirAnalista").dialog({
            autoOpen: false,
            modal: true,
            width: 400,
            open: function () { $(this).parent().css('overflow', 'visible'); $$.utils.forms.resize(); }
        }).find('#btnEnviarAnalista').click(function () {
            var $el = $(this).parents('.ui-dialog-content');

            // Forzamos la lectura directa de variables para saltarnos bloqueos silenciosos
            var origenId = $("#txtTipoPagoOrigenId").val();
            var analistaId = $("#cboAnalistas").val();
            var monto = $("#txtImporteAnalista").val();
            var desc = $("#txtDescripcionAnalista").val();

            // Validaciones manuales de seguridad antes de disparar el AJAX
            if (!analistaId || analistaId === "") {
                Vendix.Dialogo("Por favor, seleccione un analista de la lista");
                return;
            }
            if (parseFloat(monto) <= 0 || monto === "") {
                $("#txtImporteAnalista").focus();                
                Vendix.Dialogo("Ingrese un monto válido mayor a cero");
                return;
            }

            // Desactivamos el botón temporalmente para evitar doble clic accidental
            $("#btnEnviarAnalista").prop("disabled", true).val("Procesando...");

            // Disparamos la transferencia al Servidor
            $.ajax({
                type: 'POST',
                url: "@Url.Action("TransferirAAnalista", "Boveda")",
                data: {
                    pTipoPagoId: origenId,
                    pUsuarioAnalistaId: analistaId,
                    pImporte: monto,
                    pDescripcion: desc
                },
                success: function (data) {
                    // Restablecemos el botón
                    $("#btnEnviarAnalista").prop("disabled", false).val("Confirmar Transferencia");

                    if (data == true || data.success == true) {
                        Vendix.Notificar("Grabar");
                        $el.find('form')[0].reset();
                        $el.dialog('close');
                        location.reload(); // Refresca las tarjetas web al instante
                    } else {                        
                        Vendix.Dialogo(data.message || "Sucedió un error al procesar la transferencia con el analista.");
                    }
                },
                error: function (xhr, status, error) {
                    // ¡EL SALVAVIDAS!: Si el controlador falla, esto te dirá exactamente qué pasó
                    $("#btnEnviarAnalista").prop("disabled", false).val("Confirmar Transferencia");
                    alert("Error en el Servidor (Código " + xhr.status + "): No se pudo procesar la ruta del BovedaController. Verifique que el método 'TransferirAAnalista' exista.");
                }
            });
        }).end().find('button.cancel').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            $el.find('form')[0].reset();
            $el.dialog('close');
        });

        // =================================================================
        // DETECTOR Y Escuchador de clics para tus 8 tarjetas
        // =================================================================
        // B. Listener del evento clic modificado para centrar texto e inyectar logos
        $(document).on('click', '.boveda-card', function () {
            var tipoPagoId = $(this).data('id');

            // 1. DICCIONARIO DE TEXTOS: Sincronizado con Denominacion de la BD (Huanta)
            var nombresBancos = {
                1: "EFECTIVO",
                2: "YAPE CENTRAL",
                3: "INTERBANK CENTRAL",
                4: "BCP CENTRAL",
                5: "BANCO DE LA NACIÓN",
                // NUEVOS: Cuentas Macomunadas de Sucursal
                6: "YAPE HUANTA",
                7: "INTERBANK HUANTA",
                8: "BCO CREDITO HUANTA"
            };

            // 2. DICCIONARIO DE LOGOS: Mapeamos los recursos visuales de tu proyecto
            var logosBancos = {
                1: '@Url.Content("~/img/boveda/Money.png")',
                2: '@Url.Content("~/img/boveda/Yape2.png")',
                3: '@Url.Content("~/img/boveda/Interbank2.png")',
                4: '@Url.Content("~/img/boveda/BCP.png")',
                5: '@Url.Content("~/img/boveda/BN.png")',
                // NUEVOS: Reutilizamos tus logos icónicos para mantener la familiaridad
                6: '@Url.Content("~/img/boveda/Yape2.png")',
                7: '@Url.Content("~/img/boveda/Interbank2.png")',
                8: '@Url.Content("~/img/boveda/BCP.png")'
            };

            if ($("#dlgTransferirAnalista").length === 0) {
                alert("¡El JavaScript del click SÍ funciona, pero el contenedor HTML del modal '#dlgTransferirAnalista' NO está presente en la vista Index.cshtml.");
                return;
            }

            // Seteamos los datos de ID y el texto del origen
            $("#txtTipoPagoOrigenId").val(tipoPagoId);
            $("#lblBancoOrigenSeleccionado").text(nombresBancos[tipoPagoId]);

            // Inyectamos dinámicamente la ruta de la imagen y la hacemos visible en la cabecera Flexbox
            if (logosBancos[tipoPagoId]) {
                $("#imgBancoOrigen").attr("src", logosBancos[tipoPagoId]).show();
            } else {
                $("#imgBancoOrigen").hide();
            }

            // Limpiamos los campos del formulario para una nueva operación limpia
            $("#cboAnalistas").val("").trigger("liszt:updated"); // Soporte nativo por si usas Chosen/Select2
            $("#txtImporteAnalista").val("");
            $("#txtDescripcionAnalista").val("");

            // Desplegamos el modal en pantalla
            $('#dlgTransferirAnalista').dialog('open');
        });


        // =================================================================
        // RESTO DE FUNCIONALIDADES ORIGINALES RECUPERADAS Y CORREGIDAS
        // =================================================================

        // CORREGIDO: Se añade 'event' como parámetro de entrada
        $("#btnRptBoveda").click(function (event) {
            event.preventDefault();
            window.open(obtenerRutaReporteBoveda('PDF'));
            return false;
        });

        function obtenerRutaReporteBoveda(tipo) {
            return '@Url.Action("ReporteMovimientoBoveda", "Reporte")' + '?pBovedaId=null' + '&pTipo=' + tipo;
        };

        $("#rbOficina,#rbCaja,#rbCajaChica,#rbBancos").change(function () {
            $(".Caja, .Oficina, .CajaChica, .Bancos").hide();
            if ($("#rbCaja").prop('checked')) {
                $(".Caja").show();
            } else if ($("#rbOficina").prop('checked')) {
                $(".Oficina").show();
            } else if ($("#rbCajaChica").prop('checked')) {
                $(".CajaChica").show();
            } else if ($("#rbBancos").prop('checked')) {
                $(".Bancos").show();
            }
        });

        $('#btnTransferir').click(function () {
            var $el = $("#dlgTransferir");
            $el.find('form')[0].reset();
            MostrarSaldosBoveda();
            $(".Caja").show();
            $(".Oficina, .CajaChica, .Bancos").hide();
            $("#cboCajas,#cboOficinas,#cboBancoOrigen,#cboBancoDestino").val("").trigger("liszt:updated");
            $("#lblMensaje").text("");
            $('#dlgTransferir').dialog('open');
            return false;
        });

        $("#dlgTransferir").dialog({
            autoOpen: false,
            modal: true,
            width: 400,
            open: function () { $(this).parent().css('overflow', 'visible'); $$.utils.forms.resize(); }
        }).find('#btnEnviar').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            if ($el.validate().form()) {

                if ($("#rbBancos").prop('checked')) {
                    var origenId = $("#cboBancoOrigen").val();
                    var destinoId = $("#cboBancoDestino").val();

                    if (origenId === destinoId) {
                        $("#cboBancoDestino").focus();
                        $("#lblMensaje").text("El banco de origen y destino no pueden ser iguales.");
                        return;
                    }
                    if (parseFloat($("#txtImporte").val()) <= 0 || $("#txtImporte").val() === "") {
                        $("#txtImporte").focus();
                        $("#lblMensaje").text("Ingrese un importe mayor a cero.");
                        return;
                    }

                    TransferirMontoBancos(origenId, destinoId, "@Url.Action("RegistrarTransferenciaBancos", "Boveda")", $el);

                } else {
                    if (parseFloat($("#lblMontoBoveda").text()) >= parseFloat($("#txtImporte").val())) {
                        if ($("#rbCaja").prop('checked')) {
                            TransferirMonto($("#cboCajas").val(), "@Url.Action("TransferirCaja", "Boveda")", $el);
                        } else if ($("#rbOficina").prop('checked')) {
                            TransferirMonto($("#cboOficinas").val(), "@Url.Action("TransferirOficina", "Boveda")", $el);
                        } else {
                            TransferirMontoCajaChica("@Url.Action("TransferirCajaChica", "Boveda")", $el);
                        }
                    } else {
                        $("#txtImporte").focus();
                        $("#lblMensaje").text("El importe debe ser menor al Monto en Boveda");
                    }
                }
            }
        }).end().find('button.cancel').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            $el.find('form')[0].reset();
            $el.dialog('close');
        });

        $('#btnIngresoEgreso').click(function () {
            var $el = $("#dlgIngresoEgreso");
            $el.find('form')[0].reset();
            $("#cboTipoOperacion,#cboTipoCuenta").val("").trigger("liszt:updated");
            $("#lblMensajeb").text("");
            $('#dlgIngresoEgreso').dialog('open');
            return false;
        });

        $('#btnTransferirBovedaTemp').click(function () {
            $.data(document.body, 'AsignarBovedaTemporal', false);
            $.ajax({
                type: 'GET',
                url: '@Url.Action("ExisteBovedaTemporal", "Boveda")',
                data: {},
                success: function (data) {
                    if (data == true) {
                        var $el = $("#dlgAsignarBovedaTemporal");
                        $el.find('form')[0].reset();
                        $("#cboUsuario").val("").trigger("liszt:updated");
                        $("#lblMensajeAsignarBovedaTemp").text("");
                        $('#dlgAsignarBovedaTemporal').dialog('open');
                        $(".usuario").hide();
                    } else {
                        Vendix.Dialogo("No Existe una boveda Temporal Abierta");
                    }
                }
            });
            return false;
        });

        $('#btnAsignarBovedaTemp').click(function () {
            $(".usuario").show();
            $.data(document.body, 'AsignarBovedaTemporal', true);
            $.ajax({
                type: 'GET',
                url: '@Url.Action("ExisteBovedaTemporal", "Boveda")',
                data: {},
                success: function (data) {
                    if (data == false) {
                        var $el = $("#dlgAsignarBovedaTemporal");
                        $el.find('form')[0].reset();
                        $("#cboUsuario").val("").trigger("liszt:updated");
                        $("#lblMensajeAsignarBovedaTemp").text("");
                        $('#dlgAsignarBovedaTemporal').dialog('open');
                    } else {
                        Vendix.Dialogo("Ya Existe una boveda Temporal Creada");
                    }
                }
            });
            return false;
        });

        $("#dlgIngresoEgreso").dialog({
            autoOpen: false,
            modal: true,
            width: 450,
            open: function () { $(this).parent().css('overflow', 'visible'); $$.utils.forms.resize(); }
        }).find('#btnGuardarIngresoEgreso').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            if ($el.validate().form()) {
                if ($("#cboTipoOperacion").val() != 20) {
                    if (parseFloat($("#txtImporteb").val()) > parseFloat('@Model.SaldoFinal')) {
                        $("#txtImporteb").focus();
                        $("#lblMensajeb").text("El importe debe ser menor o igual al Saldo final en Boveda");
                        return;
                    }
                }
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("IngresoEgreso", "Boveda")',
                    data: {
                        pImporte: $('#txtImporteb').val(),
                        pDescripcion: $("#txtDescripcionb").val(),
                        pTipoOperacionId: $("#cboTipoOperacion").val(),
                        pTipoCuentaId: $("#cboTipoCuenta").val()
                    },
                    success: function (data) {
                        if (data == true) {
                            Vendix.Notificar("Grabar");
                            $el.find('form')[0].reset();
                            $el.dialog('close');
                            location.reload();
                        } else {
                            alert("Sucedio un Error al Realizar la Transaccion consulte Con Area de Sistemas");
                        }
                    }
                });
            }
        }).end().find('button.cancel').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            $el.find('form')[0].reset();
            $el.dialog('close');
        });

        $("#dlgAsignarBovedaTemporal").dialog({
            autoOpen: false,
            modal: true,
            width: 450,
            open: function () { $(this).parent().css('overflow', 'visible'); $$.utils.forms.resize(); }
        }).find('#btnGuardarAsignarTemporal').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            if ($el.validate().form()) {
                if (parseFloat($("#txtImporteTemp").val()) > parseFloat('@Model.SaldoFinal')) {
                    $("#txtImporteTemp").focus();
                    $("#lblMensajeAsignarBovedaTemp").text("El importe debe ser menor o igual al Saldo final en Boveda");
                    return;
                }
                var esAsignarBovedaTmp = $.data(document.body, 'AsignarBovedaTemporal');
                var usuarioBovedaTmpId = esAsignarBovedaTmp ? $("#cboUsuario").val() : 0;

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AsignarBovedaTemporal", "Boveda")',
                    data: {
                        pImporte: $('#txtImporteTemp').val(),
                        pDescripcion: $("#txtDescripcionTemp").val(),
                        pUsuarioId: usuarioBovedaTmpId
                    },
                    success: function (data) {
                        if (data.length == 0) {
                            Vendix.Notificar("Grabar");
                            $el.find('form')[0].reset();
                            $el.dialog('close');
                            location.reload();
                        } else {
                            Vendix.Dialogo(data);
                        }
                    }
                });
            }
        }).end().find('button.cancel').click(function () {
            var $el = $(this).parents('.ui-dialog-content');
            $el.find('form')[0].reset();
            $el.dialog('close');
        });

        // CORREGIDOS: Se les agrega 'event' a los botones de reportes vencidos
        $("#btnReporteVencidos").click(function (event) {
