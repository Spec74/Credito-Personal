    function TransferirMonto(cboId, pUrl, $el) {
        $.ajax({
            type: 'POST',
            url: pUrl,
            data: { pImporte: $('#txtImporte').val(), pDescripcion: $("#txtDescripcion").val(), pCboId: cboId },
            success: function (data) {
                if (data == true) {
                    Vendix.Notificar("Grabar");
                    $("#grdBovedaMov").trigger("reloadGrid");
                    $el.find('form')[0].reset();
                    $el.dialog('close');
                    location.reload();
                } else {
                    alert("Sucedio un Error al Realizar la Transaccion consulte Con Area de Sistemas");
                }
            }
        });
    }
    function TransferirMontoCajaChica(pUrl, $el) {
        $.ajax({
            type: 'POST',
            url: pUrl,
            data: { pImporte: $('#txtImporte').val(), pDescripcion: $("#txtDescripcion").val() },
            success: function (res) {
                if (res.length == 0) {
                    Vendix.Notificar("Grabar");
                    $("#grdBovedaMov").trigger("reloadGrid");
                    $el.find('form')[0].reset();
                    $el.dialog('close');
                    location.reload();
                } else {
                    alert(res);
                }
            }
        });
    }

    function TransferirMontoBancos(origenId, destinoId, pUrl, $el) {
        $.ajax({
            type: 'POST',
            url: pUrl,
            data: {
                tipoPagoOrigenId: origenId,
                tipoPagoDestinoId: destinoId,
                importe: $('#txtImporte').val(),
                glosa: $("#txtDescripcion").val()
            },
            success: function (response) {
                if (response.success === true) {
                    Vendix.Notificar("Grabar");
                    $("#grdBovedaMov").trigger("reloadGrid");
                    $el.find('form')[0].reset();
                    $el.dialog('close');
                    location.reload();
                } else {
                    alert(response.message || "Sucedió un error al realizar la transferencia.");
                }
            },
            error: function () {
                alert("Error de comunicación. No se pudo contactar con el controlador de Bóveda.");
            }
        });
    }

    function MostrarSaldosBoveda() {
        $.ajax({
            type: 'POST',
            url: "@Url.Action("MostrarMontoBoveda","Saldos")",
            data: {},
            success: function (data) { $("#lblMontoBoveda").text(data); }
        });
    }
</script>