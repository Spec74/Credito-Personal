@using System.Globalization
@using ITB.VENDIX.BL
@model ITB.VENDIX.DA.Boveda

<div class="grid_12 " id="recargar_estado">
    <div class="box ">
        <div class="header">
            <h2>
                <img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />
                ESTADO DE DINERO
            </h2>
        </div>
        <div class="content center-elements">
            <br />
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@Model.SaldoFinal" data-title="BOVEDA" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@ViewBag.MontoCajachica" data-title="CAJA CHICA" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@ViewBag.MontoCajas" data-title="CAJAS" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@ViewBag.MontoPlanPagoPendiente" data-title="CREDITOS" data-format="0.00"></a>
            </div>

            <br />
            <div class="full-stats">
                <a id="btnReporteVencidos" href="javascript:void(0);" class="stat simple" data-value="@ViewBag.MontoVencido" data-title="CREDITOS VENCIDOS" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a id="btnReporteVencidoMenor60" href="javascript:void(0);" class="stat simple" data-value="@ViewBag.VencidoMenor60" data-title="Vencido sin Mora (<60)" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a id="btnReporteVencidoMayor60" href="javascript:void(0);" class="stat simple" data-value="@ViewBag.VencidoMayor60" data-title="Vencido con Mora (>60)" data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a id="btnReporteVencidoIrrecuperable" href="javascript:void(0);" class="stat simple" data-value="@ViewBag.VencidoIrrecuperable" data-title="Vencido Irrecuperable" data-format="0.00"></a>
            </div>

            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@ViewBag.TotalFondo" data-title="TOTAL FONDO S/." data-format="0.00"></a>
            </div>
        </div>
        <div class="actions"></div>
    </div>
</div>

<div class="grid_12 " id="recargar">
    <div class="box ">
        <div class="header">
            <h2>
                <img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />
                BOVEDA @(VendixGlobal<string>.Obtener("NombreOficina")) Fecha Inicio Operacion: @Model.FechaIniOperacion
            </h2>
        </div>






        <div class="content center-elements">
            <br />
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@Model.SaldoInicial" data-title="SALDO INICIAL S/." data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@Model.Entradas" data-title="ENTRADAS S/." data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@Model.Salidas" data-title="SALIDAS S/." data-format="0.00"></a>
            </div>
            <div class="full-stats">
                <a href="javascript:void(0);" class="stat simple" data-value="@Model.SaldoFinal" data-title="SALDO FINAL S/." data-format="0.00"></a>
            </div>
            <br />

            <div style="display: none !important;">
                <label id="lblResumenCuenta">@ViewBag.ResumenCuentaBoveda</label>
            </div>

            <div class="resumen-boveda-container">
                <!-- 1. Cuentas de Oficina Principal -->
                <div class="boveda-card card-efectivo" data-id="1" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/Money.png" alt="Efectivo" /></div>
                    <div class="card-content">
                        <span class="card-title">Efectivo</span>
                        <span class="card-amount" id="val-efectivo">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-yape" data-id="2" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/Yape2.png" alt="Yape" /></div>
                    <div class="card-content">
                        <span class="card-title">Yape Central</span>
                        <span class="card-amount" id="val-yape">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-interbank" data-id="3" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/Interbank2.png" alt="Interbank" /></div>
                    <div class="card-content">
                        <span class="card-title">Interbank Central</span>
                        <span class="card-amount" id="val-interbank">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-bcp" data-id="4" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/BCP.png" alt="BCP" /></div>
                    <div class="card-content">
                        <span class="card-title">BCP Central</span>
                        <span class="card-amount" id="val-bcp">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-bn" data-id="5" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/BN.png" alt="Banco de la Nacion" /></div>
                    <div class="card-content">
                        <span class="card-title">Banco de la Nación</span>
                        <span class="card-amount" id="val-bn">S/. 0.00</span>
                    </div>
                </div>

                <!-- 2. Nuevas Cuentas Macomunadas (Sucursal Huanta) -->
                <div class="boveda-card card-yape" data-id="6" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/Yape2.png" alt="Yape Huanta" /></div>
                    <div class="card-content">
                        <span class="card-title">Yape Huanta</span>
                        <span class="card-amount" id="val-yape2">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-interbank" data-id="7" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/Interbank2.png" alt="Interbank Huanta" /></div>
                    <div class="card-content">
                        <span class="card-title">Interbank Huanta</span>
                        <span class="card-amount" id="val-interbank2">S/. 0.00</span>
                    </div>
                </div>
                <div class="boveda-card card-bcp" data-id="8" style="cursor: pointer;">
                    <div class="card-icon"><img src="~/img/boveda/BCP.png" alt="BCP Huanta" /></div>
                    <div class="card-content">
                        <span class="card-title">BCP Huanta</span>
                        <span class="card-amount" id="val-bcp2">S/. 0.00</span>
                    </div>
                </div>
            </div>
        </div>






        <div class="actions">
            <div class="left">
                <a href="#" id="btnRptBoveda" class="button">MOVIMIENTOS</a>
            </div>
            <div class="right">
                <a href="#" id="btnIngresoEgreso" class="button">INGRESO EGRESO</a>
                <a href="#" id="btnTransferir" class="button">TRANSFERENCIAS</a>
                <a href="#" id="btnCerrar" class="button red">CIERRE BOVEDA</a>
            </div>
        </div>
        <div class="actions">
            <div class="right">
                <a href="#" id="btnAsignarBovedaTemp" class="button grey">ASIGNAR BOVEDA TEMPORAL</a>
                <a href="#" id="btnTransferirBovedaTemp" class="button grey">TRANSFERIR A BOVEDA TEMPORAL</a>
                <a href="#" id="btnCerrarBovedaTemp" class="button grey">CERRAR BOVEDA TEMPORAL</a>
            </div>
        </div>
    </div>
</div>

<div class="grid_12 ">
    <div class="box">
        <div class="header">
            <h2>
                <img class="icon" src="~/img/icons/packs/fugue/16x16/receipt-invoice.png" />BOVEDA
            </h2>
        </div>
        <div class="content">
            <div class="clearfix"></div>
            <table id="grdBoveda"></table>
            <div id="grdpBoveda"></div>

            <div class="spacer"></div>
            <div class="clearfix"></div>
            <table id="grdBovedaMov"></table>
            <div id="grdpBovedaMov"></div>

            <div class="spacer"></div>
            <div class="clearfix"></div>
            <table id="grdCajaDiario"></table>
            <div id="grdpCajaDiario"></div>
        </div>
        <div class="spacer"></div>
        <div class="actions">
            <div class="left">
                <a href="#" class="button grey">Imprimir</a>
            </div>
            <div class="right">
                <a href="#" class="button">Movimientos</a>
