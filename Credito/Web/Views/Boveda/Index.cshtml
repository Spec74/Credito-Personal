<div style="display: none;" id="dlgTransferirAnalista" title="Transferencia a Analista">
    <form class="full validate">
        <input type="hidden" id="txtTipoPagoOrigenId" />

        <div class="row" style="background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 7px 0; margin-bottom: 7px; border-radius: 6px;">
            <div style="display: flex; align-items: center; justify-content: center; gap: 12px;">
                <img id="imgBancoOrigen" src="" alt="Banco Origen" style="height: 32px; width: auto; display: none; object-fit: contain;" />
                <span id="lblBancoOrigenSeleccionado" style="font-size: 16px; font-weight: bold; color: #005d9a; letter-spacing: 0.3px; text-transform: uppercase;"></span>
            </div>
        </div>

        <div class="row">
            <label for="cboAnalistas"><strong>Analista Destino:</strong></label>
            <div>
                @Html.DropDownList("cboAnalistas", (IEnumerable<SelectListItem>)ViewBag.cboAnalistas, " Seleccione Analista ", new { @style = "width: 100%;", @class = "required" })
            </div>
        </div>

        <div class="row">
            <label for="txtImporteAnalista"><strong>Importe S/.:</strong></label>
            <div>
                <input type="number" id="txtImporteAnalista" placeholder="0.00" min="0.01" step="0.01" required="required" style="font-weight: bold; color: #1e293b; font-size: 14px;" />
            </div>
        </div>

        <div class="row">
            <label for="txtDescripcionAnalista"><strong>Descripción:</strong></label>
            <div>
                <input type="text" id="txtDescripcionAnalista" placeholder="Ej. Remesa de efectivo diario o cuadre" maxlength="200" />
            </div>
        </div>
    </form>

    <div class="actions">
        <div class="left">
            <button class="grey cancel">Salir</button>
        </div>
        <div class="right">
            <input id="btnEnviarAnalista" type="button" value="Confirmar Transferencia" style="font-weight: bold;" />
        </div>
    </div>
</div>

<script type="text/javascript">
    $$.ready(function () {
        // Función interna para el procesado de las tarjetas visuales
        function procesarResumenBoveda() {
            var textoRaw = $("#lblResumenCuenta").text();
            if (!textoRaw || textoRaw.trim() === "") return;

            var regexes = {
                efectivo: /EFECTIVO\s*=\s*(-?[\d.]+)/i,
                yape: /YAPE\s*=\s*(-?[\d.]+)/i,
                interbank: /INTERBANK\s*=\s*(-?[\d.]+)/i,
                bcp: /BCO CREDITO\s*=\s*(-?[\d.]+)/i,
                bn: /BCO NACION\s*=\s*(-?[\d.]+)/i,

                // NUEVOS: Canales de Sucursal Huanta mapeados con sus respectivos IDs HTML
                yape2: /YAPE HUANTA\s*=\s*(-?[\d.]+)/i,
                interbank2: /INTERBANK HUANTA\s*=\s*(-?[\d.]+)/i,
                bcp2: /BCO CREDITO HUANTA\s*=\s*(-?[\d.]+)/i
            };

            function formatSoles(numStr) {
                var num = parseFloat(numStr);
                if (isNaN(num)) return "S/. 0.00";
                return "S/. " + num.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            Object.keys(regexes).forEach(function (key) {
                var match = textoRaw.match(regexes[key]);
                if (match && match[1]) {
                    $("#val-" + key).text(formatSoles(match[1]));
                } else {
                    // Salvavidas: Si una cuenta nueva aún no genera movimientos en la BD, se inicializa en 0.00
                    if ($("#val-" + key).text() === "" || $("#val-" + key).text() === "S/. 0.00") {
                        $("#val-" + key).text("S/. 0.00");
                    }
                }
            });
        }

        // Carga Inicial del parseador de tarjetas
        procesarResumenBoveda();

        // Escucha recargas AJAX del core del sistema
        $("#lblResumenCuenta").on("change DOMSubtreeModified", function () {
            procesarResumenBoveda();
        });


        // Inicialización de jqGrids y controladores del DOM existentes
        $("#grdBoveda").jqGrid({
            url: "@Url.Action("ListarBovedaJgrid", "Boveda")",
            datatype: "json",
            postData: {
                filters: function () {
                    return $.toJSON([{ Key: "Buscar", Value: '1' }]);
                }
            },
            colNames: ['ID','Tipo', 'SaldoInicial', 'Entradas', 'Salidas', 'SaldoFinal', 'FechaIniOperacion', 'FechaFinOperacion', 'Cierre', 'Accion'],
            colModel: [
                { name: 'BovedaId', index: 'BovedaId', width: 50, align: 'center' },
                { name: 'Tipo', index: 'Tipo', width: 70, align: 'center' },
                { name: 'SaldoInicial', index: 'SaldoInicial', align: 'center' },
                { name: 'Entradas', index: 'Entradas', align: 'center' },
                { name: 'Salidas', index: 'Salidas', align: 'center' },
                { name: 'SaldoFinal', index: 'SaldoFinal', align: 'center' },
                { name: 'FechaIniOperacion', index: 'FechaIniOperacion', align: 'center' },
                { name: 'FechaFinOperacion', index: 'FechaFinOperacion', align: 'center' },
                { name: 'IndCierre', index: 'IndCierre',width: 70, align: 'center' },
                { name: 'imprimir', index: 'imprimir', align: 'center', width: 60, formatter: ImprimirReporteBoveda }
            ],
            caption: "Cierres de Boveda",
            pager: jQuery('#grdpBoveda'),
            rowNum: 5,
            rowList: [5, 10, 15],
            sortname: 'BovedaId',
            sortorder: "desc",
            viewrecords: true,
            rownumbers: true,
            autowidth: true,
            width: 'auto',
            height: '160px',
            gridComplete: function () {
                var grid = $('#grdBoveda');
                var ids = grid.jqGrid("getDataIDs");
                if (ids.length > 0) {
                    grid.jqGrid("setSelection", ids[0]);
                }
            },
            onSelectRow: function (id) {
                if (id) {
                    $.data(document.body, 'grdBovedaId', id);

                    if ($("#gbox_grdBovedaMov").length > 0)
                        $("#grdBovedaMov").trigger("reloadGrid");
                    else {
                        $("#grdBovedaMov").jqGrid({
                            url: "@Url.Action("ListarBovedaMovJgrid", "Boveda")",
                            datatype: "json",
                            postData: {
                                filters: function () {
                                    return $.toJSON([{ Key: "BovedaId", Value: $.data(document.body, 'grdBovedaId') }]);
                                }
                            },
                            colNames: ['MovimientoBovedaId', 'ID', 'CAJA DIARIO', 'FECHA', 'OPERACION','TIPO PAGO', 'GLOSA', 'IMPORTE', 'ACCION'],
                            colModel: [
                                { name: 'MovimientoBovedaId', index: 'MovimientoBovedaId', hidden: true },
                                { name: 'BovedaId', index: 'BovedaId', width: 50, align: 'center' },
                                { name: 'CajaDiarioId', index: 'CajaDiarioId', width: 50, align: 'center' },
                                { name: 'FechaReg', index: 'FechaReg', width: 100, align: 'center' },
                                { name: 'CodOperacion', index: 'CodOperacion', width: 60, align: 'center' },
                                { name: 'TipoPago', index: 'TipoPago', width: 60, align: 'center' },
                                { name: 'Glosa', index: 'Glosa', width: 300 },
                                { name: 'Importe', index: 'Importe', width: 80, align: 'right' },
                                { name: 'imprimir', index: 'imprimir', align: 'center', width: 60, formatter: ImprimirReporteBovedaMov }
                            ],
                            caption: "Movimientos Boveda",
                            pager: $('#grdpBovedaMov'),
                            rowNum: 5,
                            rowList: [5, 10, 15],
                            sortname: 'MovimientoBovedaId',
                            sortorder: "desc",
                            viewrecords: true,
                            rownumbers: true,
                            autowidth: true,
                            width: 'auto',
                            height: '160px'
                        });
                    }

                    if ($("#gbox_grdCajaDiario").length > 0)
                        $("#grdCajaDiario").trigger("reloadGrid");
                    else {
                        $("#grdCajaDiario").jqGrid({
                            url: "@Url.Action("ListarSaldoCajaDiarioBoveda", "Saldos")",
                            datatype: "json",
                            postData: {
                                filters: function () {
                                    return $.toJSON([{ Key: "BovedaId", Value: $.data(document.body, 'grdBovedaId') }]);
                                }
                            },
