<div style="display: none;" id="dlgTransferir" title="Realizar Transferencia">
    <form class="full validate">
        <div class="row">
            <label><strong>Transferencia:</strong></label>
            <div>
                <table>
                    <tr>
                        <td>
                            <input type="radio" name="rbTipoTransferencia" id="rbCaja" value="caja" checked="checked" /><label for="rbCaja"> CAJA</label>  &nbsp;&nbsp;
                            <input type="radio" name="rbTipoTransferencia" id="rbOficina" value="oficina" /><label for="rbOficina">OFICINA</label> &nbsp;&nbsp;
                            <input type="radio" name="rbTipoTransferencia" id="rbCajaChica" value="cajachica" /><label for="rbCajaChica">CAJACHICA</label> &nbsp;&nbsp;
                            <input type="radio" name="rbTipoTransferencia" id="rbBancos" value="bancos" /><label for="rbBancos">ENTRE BANCOS</label>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row Oficina">
            <label for="cboOficinas"><strong>Oficina :</strong></label>
            <div>@Html.DropDownList("cboOficinas", (IEnumerable<SelectListItem>)ViewBag.cboOficinas)</div>
        </div>
        <div class="row Caja">
            <label for="cboCajas"><strong>Caja :</strong></label>
            <div>@Html.DropDownList("cboCajas", (IEnumerable<SelectListItem>)ViewBag.cboCajas)</div>
        </div>
        <div class="row CajaChica">
            <label><strong>Caja :</strong></label>
            <div><p>CAJA CHICA</p></div>
        </div>

        <div class="row Bancos" style="display: none;">
            <label for="cboBancoOrigen"><strong>Origen :</strong></label>
            <div>
                <select id="cboBancoOrigen" style="width: 100%; padding: 4px;">
                    <option value="1">EFECTIVO</option>
                    <option value="2">YAPE CENTRAL</option>
                    <option value="3">INTERBANK CENTRAL</option>
                    <option value="4">BCP CENTRAL</option>
                    <option value="5">BANCO NACION</option>
                    <!-- 🚨 NUEVOS BANCOS SUCURSAL HUANTA -->
                    <option value="6">YAPE HUANTA</option>
                    <option value="7">INTERBANK HUANTA</option>
                    <option value="8">BCP HUANTA</option>
                </select>
            </div>
            <br />
            <label for="cboBancoDestino"><strong>Destino :</strong></label>
            <div>
                <select id="cboBancoDestino" style="width: 100%; padding: 4px;">
                    <option value="1">EFECTIVO</option>
                    <option value="2">YAPE CENTRAL</option>
                    <option value="3">INTERBANK CENTRAL</option>
                    <option value="4">BCP CENTRAL</option>
                    <option value="5">BANCO NACION</option>
                    <!-- 🚨 NUEVOS BANCOS SUCURSAL HUANTA -->
                    <option value="6">YAPE HUANTA</option>
                    <option value="7">INTERBANK HUANTA</option>
                    <option value="8">BCP HUANTA</option>
                </select>
            </div>
        </div>

        <div class="row">
            <label for="txtImporte"><strong>Importe :</strong></label>
            <div>
                <strong><span id="lblMensaje" style="color:red"></span></strong><br />
                <span><strong>Monto total de boveda : S/.  <span id="lblMontoBoveda" style="color:blue"></span></strong></span>
                <input type="number" id="txtImporte" placeholder="0.00" required="required" />
            </div>
        </div>
        <div class="row">
            <label for="txtDescripcion"><strong>Descripción :</strong></label>
            <div><input type="text" id="txtDescripcion" placeholder="Descripcion de transferencia" /></div>
        </div>
    </form>
    <div class="actions">
        <div class="left"><button class="grey cancel">Salir</button></div>
        <div class="right"><input id="btnEnviar" type="button" value="Guardar" /></div>
    </div>
</div>

<div style="display: none;" id="dlgIngresoEgreso" title="Realizar Ingresos y Egresos">
