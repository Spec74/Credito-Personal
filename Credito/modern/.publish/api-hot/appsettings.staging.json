{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "RequerirClienteAcceso": false,
    "MigracionClavePerezosa": false
  },
  "Menu": {
    "PermiteParametrosQuery": false
  },
  "Ui": {
    "UseSpaForModule": true,
    "DefaultLoginToSpa": true,
    "SpaBasePath": "/app",
    "ObservacionDias": 14
  },
  "Hosting": {
    "DisableHttpsRedirection": true,
    "AllowDevToken": true,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    }
  },
  "BrowserCors": {
    "AllowedOrigins": [
      "http://localhost:9080",
      "http://127.0.0.1:9080",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "Disabled": false,
    "LoginPermitLimit": 30,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 120,
    "RefreshWindowSeconds": 60
  }
}
