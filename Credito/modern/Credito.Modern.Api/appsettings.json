{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CreditoDatabase": {
    "ConnectionString": ""
  },
  "CreditoStorage": {
    "RootPath": ""
  },
  "ArticuloStorage": {
    "RootPath": ""
  },
  "Jwt": {
    "Issuer": "Credito.Modern",
    "Audience": "Credito.Modern",
    "RefreshAudience": "Credito.Modern.Refresh",
    "SigningKey": "",
    "AccessTokenLifetimeHours": 8,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenVersion": 1
  },
  "Auth": {
    "RequerirClienteAcceso": true,
    "MigracionClavePerezosa": false
  },
  "Menu": {
    "PermiteParametrosQuery": false
  },
  "Ui": {
    "UseSpaForModule": false,
    "DefaultLoginToSpa": false,
    "SpaBasePath": "/app",
    "ObservacionDias": 14
  },
  "Hosting": {
    "DisableHttpsRedirection": false,
    "AllowDevToken": false,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    }
  },
  "CierreGerencial": {
    "UsuarioConsultaIds": [ 3, 10 ],
    "UsuarioMetasIds": [ 10 ],
    "PermitirAdministradores": false
  },
  "BrowserCors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Disabled": false,
    "LoginPermitLimit": 15,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 60,
    "RefreshWindowSeconds": 60
  },
  "WhatsApp": {
    "Enabled": false,
    "Token": "",
    "PhoneNumberId": "",
    "ApiVersion": "v25.0",
    "TemplateVencimientoPrendario": "aviso_vencimiento_prendario",
    "TemplateLang": "es",
    "DiasAntes": 3,
    "DailyHourLocal": 8,
    "TimeZoneId": "SA Pacific Standard Time",
    "RunOnStartupIfPending": false,
    "DelayBetweenMessagesMs": 300
  }
}
