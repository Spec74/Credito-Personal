# Variables para build en Vercel (piloto Azure App Service + SPA en raíz).
# En el dashboard de Vercel → Settings → Environment Variables.

# URL absoluta de la API en Azure (obligatorio; /api/v1 relativo NO funciona en Vercel)
VITE_API_BASE_URL=https://crediconfiable-api-g3h7fja3dydsbbb7.centralus-01.azurewebsites.net/api/v1

# SPA en la raíz del dominio Vercel (no usar /app/ salvo que configure path + rewrites)
VITE_BASE_URL=/

# Maps JavaScript API + Places (obligatorio para ubicar domicilio).
# En Google Cloud Console → restringir por HTTP referrer: credito-personal.vercel.app/*
# También puede ir en vercel.json → build.env (piloto).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDYa7uY7WNkTI8AwkJR_2kSPGO6-2yBuxg

