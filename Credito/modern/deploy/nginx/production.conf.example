# nginx en servidor (Linux o Windows) — misma semantica que default.conf (staging Docker).
# Sustituir MODERN_API_HOST y MVC_LEGACY_HOST antes de desplegar.

upstream credito_modern_api {
    server MODERN_API_HOST:8080;
    keepalive 32;
}

upstream credito_mvc_legacy {
    server MVC_LEGACY_HOST:80;
}

server {
    listen 80;
    server_name credito.ejemplo.local;

    client_max_body_size 16m;

    location /health {
        proxy_pass http://credito_modern_api;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    location /swagger {
        proxy_pass http://credito_modern_api;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    location /api/v1/ {
        proxy_pass http://credito_modern_api;
        include /etc/nginx/proxy_params_strangler.conf;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Iconos menú legacy (Web/css, Web/img) — la SPA en /app/ los referencia en /
    location /css/ {
        proxy_pass http://credito_mvc_legacy;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    location /img/ {
        proxy_pass http://credito_mvc_legacy;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    # Iconos menú legacy (Web/css, Web/img) — la SPA en /app/ los referencia en /
    location /css/ {
        proxy_pass http://credito_mvc_legacy;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    location /img/ {
        proxy_pass http://credito_mvc_legacy;
        include /etc/nginx/proxy_params_strangler.conf;
    }

    # SPA (Credito.Modern.Web: copiar dist/ a /var/www/credito-modern-web) — Corte B
    location /app/ {
        alias /var/www/credito-modern-web/;
        index index.html;
        try_files $uri $uri/ /app/index.html;
    }

    # --- Fase 5C-7.5 (PHASE-5C-7-CUTOVER.md) ---
    # 1) Copiar spa-legacy-redirects.conf.example → /etc/nginx/spa-legacy-redirects.conf
    # 2) Piloto fase 2+: descomentar la linea siguiente:
    # include /etc/nginx/spa-legacy-redirects.conf;
    # 3) Piloto fase 3: en ese archivo, descomentar location = / → /app/login

    location / {
        proxy_pass http://credito_mvc_legacy;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
