# Preprod — ASPNETCORE_ENVIRONMENT=PreProduction
# Copiar a .env.preproduction en el host (no commitear secretos).
# Fase piloto: Ui__UseSpaForModule=false (semana 1). Ver PHASE-5C-7-CUTOVER.md.

ASPNETCORE_ENVIRONMENT=PreProduction

CreditoDatabase__ConnectionString=Server=TU_SERVIDOR_PREPROD;Database=CREDITO;User Id=...;Password=...;TrustServerCertificate=True;Encrypt=True;

Jwt__SigningKey=CAMBIAR-clave-secreta-minimo-32-bytes-utf8-preprod!!
Jwt__Issuer=Credito.Modern.PreProd
Jwt__Audience=Credito.Modern.PreProd
Jwt__RefreshAudience=Credito.Modern.PreProd.Refresh

BrowserCors__AllowedOrigins__0=https://credito-preprod.tu-dominio.local

Hosting__AllowDevToken=false
Hosting__ForwardedHeaders__Enabled=true
Hosting__ForwardedHeaders__KnownProxies__0=10.0.0.10

Auth__RequerirClienteAcceso=true
Menu__PermiteParametrosQuery=false

# Piloto semana 1 (MVC default, SPA en /app/ manual)
Ui__UseSpaForModule=false
Ui__DefaultLoginToSpa=false

# Piloto semana 2–3 (descomentar tras validar oficina)
# Ui__UseSpaForModule=true
# Ui__DefaultLoginToSpa=true
