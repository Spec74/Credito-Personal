# Plantilla variables para Credito.Modern.Api en PRODUCCION (host IIS/Kestrel o contenedor).
# NO commitear .env con secretos reales.
#
# Proxy: usar deploy/iis-arr-web.config.example o deploy/nginx/production.conf.example
# Doc: docs/migration/PHASE-3B-PROXY-E2E.md seccion 5

ASPNETCORE_ENVIRONMENT=Production

CreditoDatabase__ConnectionString=Server=TU_SERVIDOR;Database=CREDITO;User Id=...;Password=...;TrustServerCertificate=True;Encrypt=True;

Jwt__SigningKey=CAMBIAR-clave-secreta-minimo-32-bytes-utf8-produccion!!
Jwt__Issuer=Credito.Modern
Jwt__Audience=Credito.Modern
Jwt__RefreshAudience=Credito.Modern.Refresh
Jwt__RefreshTokenVersion=1

ApiPeru__BaseUrl=https://apiperu.dev/api/
# Obligatorio en Azure App Service (Application settings): ApiPeru__Token
ApiPeru__Token=

BrowserCors__AllowedOrigins__0=https://credito.tu-dominio.local

Hosting__AllowDevToken=false
# App Service: Enabled=true y KnownProxies vacio (no hace falta IP).
# IIS/nginx propio: Enabled=true + KnownProxies__0=IP del proxy.
Hosting__ForwardedHeaders__Enabled=true
# Hosting__ForwardedHeaders__KnownProxies__0=10.0.0.10

Auth__RequerirClienteAcceso=true
Auth__MigracionClavePerezosa=true
Menu__PermiteParametrosQuery=false

# WhatsApp Cloud API (token solo en el host, no en git)
WhatsApp__Enabled=false
WhatsApp__Token=
WhatsApp__PhoneNumberId=
WhatsApp__ApiVersion=v25.0

# Piloto SPA (Azure App Service + Vercel)
Ui__UseSpaForModule=true
Ui__DefaultLoginToSpa=true
BrowserCors__AllowedOrigins__0=https://credito-personal.vercel.app
